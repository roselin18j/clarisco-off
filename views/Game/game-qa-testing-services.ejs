                                                                        { icon: "https://assets.clarisco.com/assets/newgame-img/gmqat-fe30.webp", title: "CI/CD Pipeline Integration", text: "QA automation integrated into your continuous integration pipeline with automated test runs triggered on every build commit, with pass/fail reporting and defect logging before the build reaches manual QA review." },
                                                                        { icon: "https://assets.clarisco.com/assets/newgame-img/gmqat-fe31.webp", title: "Performance Regression Tracking", text: "Baseline performance benchmarks recorded per build with automated detection and alerting when a new build's frame rate, load time, or memory usage degrades beyond defined thresholds." },
                                                                        { icon: "https://assets.clarisco.com/assets/newgame-img/gmqat-fe32.webp", title: "Test Coverage Reporting", text: "Automated test coverage reports per sprint with tracking which features, code paths, and platform requirements have automated coverage versus manual-only coverage, identifying coverage gaps." }
                                                                    ]
                                                                };
                                                                function renderCards(tabId) {
                                                                    const container = document.getElementById(`cards-${tabId}`);
                                                                    if (!container || !tabCardsData[tabId]) return;

                                                                    container.innerHTML = ""; // Clear previous cards

                                                                    tabCardsData[tabId].forEach(card => {
                                                                        const col = document.createElement("div");
                                                                        col.className = "col";
                                                                        col.innerHTML = ` <div class="card h-100">
                                                                            <div class="card-body">
                                                                            <img src=${card.icon} alt=${card.title} loading="lazy" width="48" height="48" />
                                                                            <h3 class="fw-bold mb-3">${card.title}</h3>
                                                                            <p class="mb-0" style="font-size: 14px;">${card.text}</p>
                                                                             </div>
                                                                            </div>
                                                                            `;
                                                                        container.appendChild(col);
                                                                    });
                                                                }

                                                                // Initial load for active tab
                                                                renderCards("pills-t-1");

                                                                // Attach event listeners to render feature cards on tab change
                                                                document.querySelectorAll('#pills-tab [data-bs-toggle="pill"]').forEach(button => {
                                                                    button.addEventListener("shown.bs.tab", (e) => {
                                                                        const targetId = e.target.getAttribute("data-bs-target").replace("#", "");
                                                                        renderCards(targetId);
                                                                    });
                                                                });
                                                            });
                                                        </script>
                                                          <script>
                                                            // ======= EDIT THIS to change the gap between segments =======
                                                            const GAP_DEG = 3;   // degrees of empty space between each wedge
                                                            // ==============================================================

                                                            const N = 6;                 // number of segments
                                                            const CX = 307.5, CY = 307;  // wheel center (matches viewBox 615x614)
                                                            const R_OUT = 298;           // outer radius of the ring
                                                            const R_IN = 168;           // inner radius of the ring (edge nearest the center circle)
                                                            const COLORS = ['var(--seg-1)', 'var(--seg-1)', 'var(--seg-1)',
                                                                'var(--seg-1)', 'var(--seg-1)', 'var(--seg-1)'];

                                                            function pt(r, deg) {
                                                                const rad = deg * Math.PI / 180;
                                                                return [CX + r * Math.sin(rad), CY - r * Math.cos(rad)];
                                                            }

                                                            const segmentPaths = [];   // filled by drawWheel(), reused by the active outline
                                                            const outerArcPaths = [];  // just the outer rim of each wedge (used for the active stroke)
                                                            const segmentEls = [];     // the wedge <path> elements, so hovering a wedge works too
                                                            let outlineEl;             // the glowing outline path, drawn on top of the ring
                                                            let defaultIndex = 1;      // item-2 (AAA & AA Console Publishers) is active by default

                                                            function drawWheel() {
                                                                const svg = document.getElementById('wheelSvg');
                                                                svg.querySelectorAll('.segment, .segment-outline').forEach(el => el.remove());
                                                                segmentPaths.length = 0;
                                                                outerArcPaths.length = 0;
                                                                segmentEls.length = 0;

                                                                const step = 360 / N;
                                                                for (let i = 0; i < N; i++) {
                                                                    const center = i * step;
                                                                    const half = (step - GAP_DEG) / 2;
                                                                    const a0 = center - half, a1 = center + half;

                                                                    const [x1, y1] = pt(R_OUT, a0);
                                                                    const [x2, y2] = pt(R_OUT, a1);
                                                                    const [x3, y3] = pt(R_IN, a1);
                                                                    const [x4, y4] = pt(R_IN, a0);

                                                                    const d = `M ${x1.toFixed(2)},${y1.toFixed(2)} `
                                                                        + `A ${R_OUT},${R_OUT} 0 0 1 ${x2.toFixed(2)},${y2.toFixed(2)} `
                                                                        + `L ${x3.toFixed(2)},${y3.toFixed(2)} `
                                                                        + `A ${R_IN},${R_IN} 0 0 0 ${x4.toFixed(2)},${y4.toFixed(2)} Z`;

                                                                    segmentPaths.push(d);

                                                                    // open arc along just the outer rim — no straight sides, no inner arc
                                                                    outerArcPaths.push(
                                                                        `M ${x1.toFixed(2)},${y1.toFixed(2)} `
                                                                        + `A ${R_OUT},${R_OUT} 0 0 1 ${x2.toFixed(2)},${y2.toFixed(2)}`
                                                                    );

                                                                    const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
                                                                    path.setAttribute('class', `segment seg-${i + 1}`);
                                                                    path.setAttribute('d', d);
                                                                    path.setAttribute('fill', COLORS[i]);
                                                                    path.style.cursor = 'pointer';
                                                                    path.style.transition = 'filter .2s ease';
                                                                    svg.appendChild(path);
                                                                    segmentEls.push(path);
                                                                }

                                                                // outline element used to highlight whichever segment is active — every
                                                                // visual property set as an inline attribute/style so it never depends
                                                                // on this page's stylesheet actually being loaded around the widget.
                                                                outlineEl = document.createElementNS('http://www.w3.org/2000/svg', 'path');
                                                                outlineEl.setAttribute('fill', 'none');
                                                                outlineEl.setAttribute('stroke', '#FE9CB0');       // rose
                                                                outlineEl.setAttribute('stroke-width', '10');
                                                                outlineEl.setAttribute('stroke-linejoin', 'round');
                                                                outlineEl.style.filter = 'drop-shadow(0 0 8px rgba(255,77,109,.85))';
                                                                outlineEl.style.pointerEvents = 'none';
                                                                outlineEl.style.transition = 'opacity .25s ease';
                                                                outlineEl.style.opacity = '0';
                                                                svg.appendChild(outlineEl);
                                                            }

                                                            function setActive(index) {
                                                                outlineEl.setAttribute('d', outerArcPaths[index]);
                                                                outlineEl.style.opacity = '1';
                                                                const item = items[index];
                                                                document.getElementById('industryTitle').textContent = item.dataset.title;
                                                                document.getElementById('industryDesc').textContent = item.dataset.desc;
                                                                items.forEach((it, i) => it.classList.toggle('active', i === index));
                                                            }

                                                            drawWheel();

                                                            const items = Array.from(document.querySelectorAll('.industry-item'));
                                                            setActive(defaultIndex);


                                                            const AUTOPLAY_MS = 3000;
                                                            let autoplayTimer = null;

                                                            function startAutoplay() {
                                                                stopAutoplay();
                                                                autoplayTimer = setInterval(() => {
                                                                    defaultIndex = (defaultIndex + 1) % N;
                                                                    setActive(defaultIndex);
                                                                }, AUTOPLAY_MS);
                                                            }
                                                            function stopAutoplay() {
                                                                if (autoplayTimer) clearInterval(autoplayTimer);
                                                                autoplayTimer = null;
                                                            }

                                                            startAutoplay();


                                                            [...items, ...segmentEls].forEach((el, idx) => {
                                                                const i = idx % N;
                                                                el.addEventListener('mouseenter', () => {
                                                                    stopAutoplay();
                                                                    setActive(i);
                                                                });
                                                                el.addEventListener('mouseleave', () => {
                                                                    setActive(defaultIndex);
                                                                    startAutoplay();
                                                                });
                                                                el.addEventListener('click', () => {
                                                                    defaultIndex = i;
                                                                    setActive(i);
                                                                    startAutoplay();
                                                                });
                                                            });
                                                        </script>

    </body>

    </html>