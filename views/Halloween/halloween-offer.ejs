    // The arm is its own group so it can swing. The hand circle moves with the arm,
    // and thrown objects start from its position.
    const WITCH_SVG = `
      <svg viewBox="0 -10 200 110" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
