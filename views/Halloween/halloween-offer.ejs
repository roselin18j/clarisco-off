<script>
document.addEventListener('DOMContentLoaded', function () {
  const layer = document.getElementById('sparkleLayerBat');
  if (!layer) return;
  const section = layer.parentElement;

  const BAT_SVG = `
    <svg viewBox="0 0 100 60" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <g fill="#000">
        <path class="wing" d="M46 28 C34 14 16 8 2 14 C8 20 10 26 8 34 C14 30 18 32 22 40 C28 34 34 36 40 44 C42 38 44 34 46 28 Z"/>
        <g transform="translate(100,0) scale(-1,1)">
          <path class="wing" d="M46 28 C34 14 16 8 2 14 C8 20 10 26 8 34 C14 30 18 32 22 40 C28 34 34 36 40 44 C42 38 44 34 46 28 Z"/>
        </g>
        <ellipse cx="50" cy="32" rx="6" ry="10"/>
        <circle cx="50" cy="20" r="6.5"/>
        <polygon points="44,19 44.5,7 49.5,15"/>
        <polygon points="56,19 55.5,7 50.5,15"/>
      </g>
      <g fill="#ff8a00" style="filter: drop-shadow(0 0 2px #ff8a00)">
        <circle cx="47.5" cy="20" r="1.7"/>
        <circle cx="52.5" cy="20" r="1.7"/>
      </g>
    </svg>`;

  const COUNT = window.innerWidth < 768 ? 10 : 22;
  const rise = layer.offsetHeight;
  const bats = [];

  for (let i = 0; i < COUNT; i++) {
    const b = document.createElement('div');
    b.className = 'bat';
    b.innerHTML = '<div class="bat-inner">' + BAT_SVG + '</div>';

    const size = 28 + Math.random() * 40;
    b.style.width = size + 'px';
    b.style.left = Math.random() * 100 + '%';
    b.style.setProperty('--dur', (7 + Math.random() * 8) + 's');
    b.style.setProperty('--delay', (-Math.random() * 15) + 's');
    b.style.setProperty('--drift', (Math.random() * 120 - 60) + 'px');
    b.style.setProperty('--flap', (0.22 + Math.random() * 0.2) + 's');
    b.style.setProperty('--rise', rise + 'px');

    layer.appendChild(b);
    bats.push({ el: b, inner: b.firstChild, timer: null });
  }

  // ---- hover / touch dodge ----
  const RADIUS = 110;   // how close the cursor must be (px)
  const PUSH = 130;     // how far the bat jumps away (px)
  let ticking = false, mx = 0, my = 0;

  function scare() {
    ticking = false;
    bats.forEach(function (bat) {
      const r = bat.el.getBoundingClientRect();
      const cx = r.left + r.width / 2;
      const cy = r.top + r.height / 2;
      const dx = cx - mx, dy = cy - my;
      const dist = Math.hypot(dx, dy);
      if (dist > RADIUS) return;

      const nx = dx / (dist || 1), ny = dy / (dist || 1);
      const jx = nx * PUSH + (Math.random() * 40 - 20);
      const jy = ny * PUSH + (Math.random() * 40 - 20);

      bat.inner.style.transform = 'translate(' + jx + 'px,' + jy + 'px) rotate(' + (nx * 25) + 'deg)';
      bat.el.classList.add('scared');

      clearTimeout(bat.timer);
      bat.timer = setTimeout(function () {
        bat.inner.style.transform = '';
        bat.el.classList.remove('scared');
      }, 700);
    });
  }

  section.addEventListener('pointermove', function (e) {
    mx = e.clientX; my = e.clientY;
    if (!ticking) { ticking = true; requestAnimationFrame(scare); }
  });
});
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const layer = document.getElementById('graveyardLayer');
  if (!layer) return;

  const NS = 'http://www.w3.org/2000/svg';
  const rand = (a, b) => a + Math.random() * (b - a);
  const el = (name, attrs) => {
    const n = document.createElementNS(NS, name);
    for (const k in attrs) n.setAttribute(k, attrs[k]);
    return n;
  };

  function build() {
    layer.querySelectorAll('svg').forEach(s => s.remove());

    const W = layer.offsetWidth;
    const H = layer.offsetHeight;
    if (!W || !H) return;

    const svg = el('svg', { viewBox: '0 0 ' + W + ' ' + H, 'aria-hidden': 'true' });

    const defs = el('defs', {});
    defs.innerHTML =
      '<radialGradient id="graveGlowGrad">' +
        '<stop offset="0%"  stop-color="#ffa733" stop-opacity="0.95"/>' +
        '<stop offset="45%" stop-color="#ff8a00" stop-opacity="0.45"/>' +
        '<stop offset="100%" stop-color="#ff8a00" stop-opacity="0"/>' +
      '</radialGradient>';
    svg.appendChild(defs);

    const groundY = x => H - 26 + Math.sin(x / 95) * 6 + Math.sin(x / 41) * 2;

    const treeXs = [0.05, 0.2, 0.8, 0.95].map(f => W * f + rand(-20, 20));
    const crossXs = [];
    const crossCount = Math.max(7, Math.round(W / 130));
    let tries = 0;
    while (crossXs.length < crossCount && tries++ < 300) {
      const x = rand(20, W - 20);
      const farFromTrees = treeXs.every(t => Math.abs(t - x) > 45);
      const farFromCross = crossXs.every(c => Math.abs(c - x) > 55);
      if (farFromTrees && farFromCross) crossXs.push(x);
    }

    const glowGroup = el('g', {});
    const crossGroup = el('g', { fill: '#000', stroke: 'rgba(168,85,247,0.55)', 'stroke-width': '0.8' });

    crossXs.forEach(function (x) {
      const gy = groundY(x);
      const h = rand(34, 78);
      const w = h * 0.62;
      const t = Math.max(4, h * 0.11);
      const tilt = rand(-9, 9);
      const armY = h * 0.3;

      const glow = el('ellipse', {
        cx: x, cy: gy - h * 0.55, rx: h * 0.95, ry: h * 0.85,
        fill: 'url(#graveGlowGrad)', class: 'grave-glow' + (Math.random() < 0.25 ? ' flicker' : '')
      });
      glow.style.setProperty('--gdur', rand(2.5, 5) + 's');
      glow.style.setProperty('--gdelay', -rand(0, 4) + 's');
      glowGroup.appendChild(glow);

      const g = el('g', { transform: 'translate(' + x + ',' + gy + ') rotate(' + tilt + ')' });
      g.appendChild(el('path', {
        d: 'M' + (-t * 3) + ' 2 Q0 ' + (-t * 1.6) + ' ' + (t * 3) + ' 2 Z'
      }));
      g.appendChild(el('rect', { x: -t / 2, y: -h, width: t, height: h }));
      g.appendChild(el('rect', { x: -w / 2, y: -h + armY, width: w, height: t }));
      crossGroup.appendChild(g);
    });

    svg.appendChild(glowGroup);

    function makeTree(x0) {
      const levels = {};
      const maxDepth = 6;

      (function branch(x, y, len, angle, depth) {
        if (depth > maxDepth || len < 4) return;
        const x2 = x + Math.sin(angle) * len;
        const y2 = y - Math.cos(angle) * len;
        (levels[depth] = levels[depth] || []).push('M' + x.toFixed(1) + ' ' + y.toFixed(1) +
          ' L' + x2.toFixed(1) + ' ' + y2.toFixed(1));
        const kids = depth < 2 ? 3 : 2;
        for (let i = 0; i < kids; i++) {
          if (depth > 2 && Math.random() < 0.18) continue;
          branch(x2, y2, len * rand(0.68, 0.8), angle + rand(-0.75, 0.75), depth + 1);
        }
      })(x0, groundY(x0) + 4, rand(48, 68), rand(-0.12, 0.12), 0);

      const tree = el('g', { fill: 'none', stroke: '#000', 'stroke-linecap': 'round' });
      Object.keys(levels).forEach(function (d) {
        tree.appendChild(el('path', {
          d: levels[d].join(' '),
          'stroke-width': Math.max(1, 9 - d * 1.5)
        }));
      });
      const rim = tree.cloneNode(true);
      rim.setAttribute('stroke', 'rgba(168,85,247,0.35)');
      rim.querySelectorAll('path').forEach(p => {
        p.setAttribute('stroke-width', parseFloat(p.getAttribute('stroke-width')) + 1.6);
      });
      svg.appendChild(rim);
      svg.appendChild(tree);
    }
    treeXs.forEach(makeTree);

    svg.appendChild(crossGroup);

    let d = 'M0 ' + H + ' L0 ' + groundY(0).toFixed(1);
    for (let x = 0; x <= W; x += 12) d += ' L' + x + ' ' + groundY(x).toFixed(1);
    d += ' L' + W + ' ' + H + ' Z';
    svg.appendChild(el('path', { d: d, fill: '#000', stroke: 'rgba(168,85,247,0.5)', 'stroke-width': '1' }));

    layer.appendChild(svg);
  }

  // build as soon as the layer has a real size, and again if the size changes
  let lastW = 0, lastH = 0, timer;
  function sync() {
    const W = layer.offsetWidth, H = layer.offsetHeight;
    if (!W || !H) return;                         // not laid out yet, try again later
    if (W === lastW && H === lastH) return;       // nothing changed
    lastW = W; lastH = H;
    build();
  }

  sync();
  window.addEventListener('load', sync);
  if ('ResizeObserver' in window) {
    new ResizeObserver(function () {
      clearTimeout(timer);
      timer = setTimeout(sync, 150);
    }).observe(layer);
  } else {
    window.addEventListener('resize', function () {
      clearTimeout(timer);
      timer = setTimeout(sync, 200);
    });
  }
});
</script>
<script>
