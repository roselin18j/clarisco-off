      const x = t.left - l.left;
      const y = t.top - l.top;
      if (x < -10 || x > l.width + 10) return;

      const n = angry ? 3 : 1;
      const colors = angry ? angryColors : calmColors;

      for (let i = 0; i < n; i++) {
        const s = document.createElement('span');
        const d = angry ? rand(4, 9) : rand(3, 7);
        s.className = 'witch-spark';
        s.style.width = s.style.height = d + 'px';
        s.style.left = x + 'px';
        s.style.top = (y + rand(-6, 6)) + 'px';
        s.style.setProperty('--c', colors[Math.floor(Math.random() * colors.length)]);
        s.style.setProperty('--sx', (angry ? rand(-80, -20) : rand(-45, -12)) + 'px');
        s.style.setProperty('--sy', (angry ? rand(-40, 55) : rand(-10, 35)) + 'px');
        s.addEventListener('animationend', function () { s.remove(); });
        layer.appendChild(s);
      }
    }, 55);
  });
})();
</script>
<script>
(function () {
  function onReady(fn) {
    if (document.readyState !== 'loading') fn();
    else document.addEventListener('DOMContentLoaded', fn);
  }

  onReady(function () {
    const layer = document.getElementById('trainLayer');
    if (!layer) return;
    const section = layer.parentElement;

    const isMobile = window.innerWidth < 768;
    const SPEED = isMobile ? 170 : 260;       // px per second (raise = faster)
    const GAP_MIN = 3000, GAP_MAX = 7000;     // pause between passes (ms)
    const OFFER_TOP  = 'UP TO';               // small line on the sign
    const OFFER_MAIN = '40% OFF';             // big line on the sign
    const rand = (a, b) => a + Math.random() * (b - a);

    // ---------- train drawing ----------
    function buildTrainSVG() {
      const RIM = 'rgba(168,85,247,.85)';

      function win(x, y, w, h) {
        const d = (Math.random() * 3).toFixed(2);
        const du = (2 + Math.random() * 2.5).toFixed(2);
        return '<g class="tr-win" style="animation-duration:' + du + 's;animation-delay:-' + d + 's">' +
          '<rect x="' + (x - 2) + '" y="' + (y - 2) + '" width="' + (w + 4) + '" height="' + (h + 4) + '" rx="4" fill="rgba(255,138,0,.28)"/>' +
          '<rect x="' + x + '" y="' + y + '" width="' + w + '" height="' + h + '" rx="3" fill="#ffa21f"/></g>';
      }

      function wheel(cx, cy, r, cls, pin) {
        let s = '<g class="tw ' + cls + '">' +
          '<circle cx="' + cx + '" cy="' + cy + '" r="' + r + '" fill="#000" stroke="' + RIM + '" stroke-width="1.6"/>' +
          '<circle cx="' + cx + '" cy="' + cy + '" r="' + (r * 0.62).toFixed(1) + '" fill="none" stroke="rgba(168,85,247,.4)" stroke-width="1"/>';
        for (let i = 0; i < 4; i++) {
          const a = i * Math.PI / 4;
          const dx = Math.cos(a) * r * 0.93, dy = Math.sin(a) * r * 0.93;
          s += '<line x1="' + (cx - dx).toFixed(1) + '" y1="' + (cy - dy).toFixed(1) +
               '" x2="' + (cx + dx).toFixed(1) + '" y2="' + (cy + dy).toFixed(1) +
               '" stroke="rgba(168,85,247,.75)" stroke-width="1.5"/>';
        }
        s += '<circle cx="' + cx + '" cy="' + cy + '" r="' + (r * 0.16).toFixed(1) + '" fill="' + RIM + '"/>';
        if (pin) s += '<circle cx="' + (cx + r * 0.55).toFixed(1) + '" cy="' + cy + '" r="2.6" fill="#ff8a00"/>';
        return s + '</g>';
      }

      function coach(x) {
        return '<path d="M' + (x - 2) + ' 73 Q' + (x + 75) + ' 54 ' + (x + 152) + ' 73 Z"/>' +
               '<rect x="' + x + '" y="70" width="150" height="62" rx="6"/>' +
               '<rect x="' + (x + 6) + '" y="130" width="138" height="8" rx="2"/>';
      }
      function coachWindows(x) {
        let s = '';
        for (let i = 0; i < 5; i++) s += win(x + 14 + i * 28, 82, 18, 22);
        return s;
      }

      const o = [];
      o.push('<svg viewBox="0 0 700 152" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">');
      o.push('<defs>' +
        '<radialGradient id="trGlow"><stop offset="0" stop-color="#ffd27a" stop-opacity=".9"/><stop offset="1" stop-color="#ff8a00" stop-opacity="0"/></radialGradient>' +
        '<linearGradient id="trBeam" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#ffb347" stop-opacity=".45"/><stop offset="1" stop-color="#ffb347" stop-opacity="0"/></linearGradient>' +
        '</defs>');

      // headlight beam ahead of the train
      o.push('<polygon points="650,78 800,36 800,120" fill="url(#trBeam)"/>');

      // black bodies with a purple rim
      o.push('<g fill="#000" stroke="' + RIM + '" stroke-width="1.3" stroke-linejoin="round">');
      o.push(coach(32), coach(190));
      o.push('<line x1="182" y1="128" x2="190" y2="128"/><line x1="340" y1="128" x2="348" y2="128"/>');
      // tender: coal box + coal
      o.push('<rect x="352" y="82" width="68" height="42" rx="3"/>');
      o.push('<path d="M356 82 Q366 70 378 76 Q390 66 402 74 Q412 68 418 82 Z"/>');
      o.push('<rect x="348" y="122" width="76" height="10" rx="2"/>');
      // locomotive: frame, boiler, chimney, dome, cab
      o.push('<rect x="424" y="120" width="232" height="12" rx="2"/>');
      o.push('<rect x="468" y="78" width="184" height="42" rx="20"/>');
      o.push('<path d="M612 80 L614 50 L606 40 L640 40 L632 50 L634 80 Z"/>');
      o.push('<path d="M520 80 Q520 58 538 58 Q556 58 556 80 Z"/>');
      o.push('<rect x="574" y="66" width="5" height="14" rx="1"/>');
      o.push('<rect x="430" y="54" width="44" height="72"/>');
      o.push('<rect x="424" y="46" width="56" height="9" rx="3"/>');
      o.push('<circle cx="648" cy="78" r="5"/>');
      o.push('<path d="M656 128 L694 150 L660 150 Z"/>');
      o.push('</g>');
      // faint boiler bands
      o.push('<g stroke="rgba(168,85,247,.35)" stroke-width="1">' +
             '<line x1="500" y1="79" x2="500" y2="119"/><line x1="575" y1="79" x2="575" y2="119"/><line x1="605" y1="79" x2="605" y2="119"/></g>');

      // glowing windows + headlight
      o.push(coachWindows(32), coachWindows(190));
      o.push(win(440, 64, 22, 20));
      o.push('<ellipse cx="660" cy="86" rx="46" ry="28" fill="url(#trGlow)"/>');
      o.push('<circle cx="648" cy="78" r="4" fill="#ffe3a0"/>');

      // wheels
      o.push(wheel(372, 136, 14, 'tw-14', false), wheel(402, 136, 14, 'tw-14', false));
      o.push(wheel(56, 136, 14, 'tw-14', false),  wheel(158, 136, 14, 'tw-14', false));
      o.push(wheel(214, 136, 14, 'tw-14', false), wheel(316, 136, 14, 'tw-14', false));
      o.push(wheel(500, 128, 22, 'tw-22', true), wheel(552, 128, 22, 'tw-22', true), wheel(604, 128, 22, 'tw-22', true));
      o.push(wheel(642, 139, 11, 'tw-11', false));

      // coupling rod
      o.push('<g class="tr-rod"><rect x="498" y="125.5" width="108" height="5" rx="2.5" fill="#000" stroke="' + RIM + '" stroke-width="1.2"/></g>');

      // invisible points used for smoke and sparks
      o.push('<circle class="tr-chim" cx="623" cy="36" r="1" fill="none"/>');
      o.push('<circle class="tr-sp" cx="500" cy="148" r="1" fill="none"/>');
      o.push('<circle class="tr-sp" cx="552" cy="148" r="1" fill="none"/>');
      o.push('<circle class="tr-sp" cx="604" cy="148" r="1" fill="none"/>');
      o.push('</svg>');
      return o.join('');
    }

    // ---------- build ----------
    const rails = document.createElement('div');
    rails.className = 'tr-rails';
    layer.appendChild(rails);

    const train = document.createElement('div');
    train.className = 'tr-train';
    train.innerHTML = buildTrainSVG();

    // "UP TO 40% OFF" sign standing on the carriage roofs
    train.insertAdjacentHTML('beforeend',
      '<div class="tr-offer"><div class="tr-offer-board">' +
        '<span class="tr-offer-top">' + OFFER_TOP + '</span>' +
        '<span class="tr-offer-main">' + OFFER_MAIN + '</span>' +
      '</div></div>');

    layer.appendChild(train);

    const chim = train.querySelector('.tr-chim');
    const sparkPts = train.querySelectorAll('.tr-sp');

    let visible = true;
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        visible = entries[entries.length - 1].isIntersecting;
      }).observe(section);
    }

    // ---------- one pass across the screen ----------
    let running = false;

    function pass() {
      const W = layer.clientWidth || window.innerWidth;
      const trainW = Math.min(640, Math.max(360, W * 0.5));
      const unit = trainW / 700;
      train.style.width = trainW + 'px';
      train.style.setProperty('--u', unit.toFixed(4));   // scales the sign with the train

      // wheels turn at the right rate for the speed
      [['--w22', 22], ['--w14', 14], ['--w11', 11]].forEach(function (p) {
        train.style.setProperty(p[0], ((2 * Math.PI * p[1] * unit) / SPEED).toFixed(3) + 's');
      });

      const dist = W + trainW + 60;
      const dur = (dist / SPEED) * 1000;
      running = true;

      const a = train.animate([
        { transform: 'translateX(' + (-trainW - 30) + 'px)' },
        { transform: 'translateX(' + (W + 30) + 'px)' }
      ], { duration: dur, easing: 'linear', fill: 'forwards' });

      a.onfinish = function () {
        running = false;
        train.style.transform = 'translateX(-3000px)';
        a.cancel();
        setTimeout(pass, rand(GAP_MIN, GAP_MAX));
      };
    }

    setTimeout(pass, 700);

    // ---------- smoke ----------
    setInterval(function () {
      if (!running || !visible || document.hidden) return;
      const lr = layer.getBoundingClientRect();
      const cr = chim.getBoundingClientRect();
      const x = cr.left - lr.left, y = cr.top - lr.top;
      if (x < -30 || x > lr.width + 30) return;

      const s = rand(18, 30);
      const p = document.createElement('div');
      p.className = 'tr-smoke';
      p.style.width = p.style.height = s + 'px';
      p.style.left = (x - s / 2) + 'px';
      p.style.top = (y - s / 2) + 'px';
      layer.appendChild(p);

      const dx = rand(-30, 20), dy = -rand(60, 120), sc = rand(2.6, 4);
      const anim = p.animate([
        { transform: 'translate(0,0) scale(.4)', opacity: 0 },
        { opacity: .75, offset: .15 },
        { transform: 'translate(' + dx + 'px,' + dy + 'px) scale(' + sc + ')', opacity: 0 }
      ], { duration: rand(1800, 2800), easing: 'ease-out' });
      anim.onfinish = function () { p.remove(); };
    }, 130);

    // ---------- sparks from the wheels ----------
    setInterval(function () {
      if (!running || !visible || document.hidden) return;
      if (Math.random() > 0.6) return;
      const lr = layer.getBoundingClientRect();
      const pt = sparkPts[Math.floor(Math.random() * sparkPts.length)].getBoundingClientRect();
      const x = pt.left - lr.left, y = pt.top - lr.top;
      if (x < -30 || x > lr.width + 30) return;

      const d = rand(2, 4.5);
      const sp = document.createElement('div');
      sp.className = 'tr-spark';
      sp.style.width = sp.style.height = d + 'px';
      sp.style.left = x + 'px';
      sp.style.top = y + 'px';
      layer.appendChild(sp);

      const anim = sp.animate([
        { transform: 'translate(0,0)', opacity: 1 },
        { transform: 'translate(' + (-rand(5, 20)) + 'px,' + (-rand(10, 28)) + 'px)', opacity: 1, offset: .4 },
        { transform: 'translate(' + (-rand(15, 40)) + 'px,' + rand(0, 6) + 'px)', opacity: 0 }
      ], { duration: rand(450, 750), easing: 'ease-out' });
      anim.onfinish = function () { sp.remove(); };
    }, 110);
  });
})();
</script>

<script>
(function () {
  function onReady(fn) {
    if (document.readyState !== 'loading') fn();
    else document.addEventListener('DOMContentLoaded', fn);
  }

  onReady(function () {
    const layer = document.getElementById('crowLayer');
    if (!layer) return;
    const section = layer.parentElement;

    const rand = (a, b) => a + Math.random() * (b - a);
    const RIM = 'rgba(168,85,247,.85)';
    const SCARE_DIST = 60;                 // px around the crow that scares it
    const AWAY_MIN = 6000, AWAY_MAX = 12000;   // how long it stays away (ms)

    // ---------- branch ----------
    const twigs = [
      'M345 92 C352 70 368 58 388 48', 'M372 64 C376 52 386 46 400 42',
      'M120 90 C112 70 98 58 78 50',   'M150 96 C144 110 132 122 112 130',
      'M60 82 C50 70 38 64 22 62',     'M390 100 C398 114 408 120 418 124'
    ];
    let twigSVG = '';
    twigs.forEach(function (d) {
      twigSVG += '<path d="' + d + '" stroke="' + RIM + '" stroke-width="5.4"/>' +
                 '<path d="' + d + '" stroke="#000" stroke-width="3.6"/>';
    });
    const BRANCH_SVG =
      '<svg class="cr-branch" viewBox="0 0 420 140" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">' +
        '<g fill="none" stroke-linecap="round">' + twigSVG + '</g>' +
        '<path d="M420 88 C360 86 300 92 240 90 C190 88 140 92 90 86 C60 82 36 76 14 68 L16 72 C38 82 62 90 92 94 C142 100 192 96 242 100 C302 104 362 98 420 106 Z" ' +
          'fill="#000" stroke="' + RIM + '" stroke-width="1.3" stroke-linejoin="round"/>' +
      '</svg>';

    // ---------- crow ----------
    const WING = 'M64 44 C74 22 96 4 122 -10 L112 6 L116 10 L104 20 L108 26 L96 34 L98 40 L86 46 Z';
    const BODY = 'M46 24 C58 28 70 34 84 42 C96 48 112 62 134 76 L138 86 C124 84 108 74 98 68 C90 78 74 82 60 78 C44 74 34 60 34 46 C34 38 36 30 46 24 Z';
    const LEGS = 'M66 76 L64 98 M80 74 L80 98 M56 99 L66 99 M74 99 L86 99';

    const BIRD_SVG =
      '<svg viewBox="0 0 140 110" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">' +
        // far wing (only visible in flight)
        '<g class="cr-wing-open"><path class="cr-w cr-w2" d="' + WING + '" fill="#05020a" stroke="' + RIM + '" stroke-width="1.1" stroke-linejoin="round"/></g>' +
        // legs and toes gripping the branch
        '<g class="cr-legs" fill="none" stroke-linecap="round">' +
          '<path d="' + LEGS + '" stroke="' + RIM + '" stroke-width="4.6"/>' +
          '<path d="' + LEGS + '" stroke="#000" stroke-width="3"/>' +
        '</g>' +
        // body and tail
        '<path d="' + BODY + '" fill="#000" stroke="' + RIM + '" stroke-width="1.3" stroke-linejoin="round"/>' +
        // near wing (flight)
        '<g class="cr-wing-open"><path class="cr-w" d="' + WING + '" fill="#000" stroke="' + RIM + '" stroke-width="1.3" stroke-linejoin="round"/></g>' +
        // folded wing (perched)
        '<g class="cr-wing-fold">' +
          '<path d="M52 38 C70 38 92 52 114 76 C96 76 76 70 62 60 C54 54 50 46 52 38 Z" fill="#0c0612" stroke="rgba(168,85,247,.6)" stroke-width="1"/>' +
          '<path d="M60 48 C74 52 92 62 106 74 M64 42 C80 46 98 58 110 74" fill="none" stroke="rgba(168,85,247,.35)" stroke-width=".9"/>' +
        '</g>' +
        // head: beak, jaw, skull, glowing eye
        '<g class="cr-head">' +
          '<path d="M33 24 Q18 25 8 33 Q20 34 33 31 Z" fill="#000" stroke="' + RIM + '" stroke-width="1"/>' +
          '<g class="cr-jaw"><path d="M33 31 Q20 34 12 38 Q24 40 33 36 Z" fill="#000" stroke="' + RIM + '" stroke-width="1"/></g>' +
          '<circle cx="42" cy="28" r="12" fill="#000" stroke="' + RIM + '" stroke-width="1.2"/>' +
          '<g class="cr-eye"><circle cx="38" cy="26" r="5" fill="rgba(255,138,0,.28)"/><circle cx="38" cy="26" r="2.3" fill="#ff9a1f"/></g>' +
        '</g>' +
      '</svg>';

    const FEATHER_SVG =
      '<svg viewBox="0 0 20 60" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">' +
        '<path d="M10 2 C18 14 18 40 10 58 C2 40 2 14 10 2 Z" fill="#0b0710" stroke="rgba(168,85,247,.85)" stroke-width="1"/>' +
        '<path d="M10 6 L10 56" stroke="rgba(168,85,247,.6)" stroke-width="1"/></svg>';

    const perch = document.createElement('div');
    perch.className = 'cr-perch';
    perch.innerHTML = BRANCH_SVG + '<div class="cr-bird">' + BIRD_SVG + '</div>';
    layer.appendChild(perch);
    const bird = perch.querySelector('.cr-bird');

    let visible = true;
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        visible = entries[entries.length - 1].isIntersecting;
      }).observe(section);
    }

    // ---------- feathers ----------
    function feathers() {
      const lr = layer.getBoundingClientRect(), r = bird.getBoundingClientRect();
      const x = r.left - lr.left + r.width * 0.5, y = r.top - lr.top + r.height * 0.5;
      for (let i = 0; i < 5; i++) {
        const f = document.createElement('div');
        f.className = 'cr-feather';
        f.innerHTML = FEATHER_SVG;
        f.style.width = rand(9, 14) + 'px';
        f.style.left = (x + rand(-20, 20)) + 'px';
        f.style.top = (y + rand(-14, 14)) + 'px';
        layer.appendChild(f);
        const rot = rand(-200, 200), dx = rand(-90, 60), dy = rand(110, 230);
        const a = f.animate([
          { transform: 'translate(0,0) rotate(0deg)', opacity: 0 },
          { opacity: 1, offset: .1 },
          { transform: 'translate(' + (dx * .5) + 'px,' + (dy * .5) + 'px) rotate(' + (rot * .5) + 'deg)', opacity: 1, offset: .5 },
          { transform: 'translate(' + dx + 'px,' + dy + 'px) rotate(' + rot + 'deg)', opacity: 0 }
        ], { duration: rand(2200, 3400), easing: 'ease-out' });
        a.onfinish = function () { f.remove(); };
      }
    }

    // ---------- fly away / come back ----------
    let state = 'perched', landedAt = performance.now();

    function leave() {
      if (state !== 'perched') return;
      state = 'flying';
      bird.classList.add('fly');
      feathers();
      const lr = layer.getBoundingClientRect(), r = bird.getBoundingClientRect();
      const dx = -(r.left - lr.left) - r.width - 160;
      const dy = -(r.top - lr.top) - r.height - 80;
      const a = bird.animate([
        { transform: 'translate(0,0) rotate(0deg)', opacity: 1, offset: 0 },
        { transform: 'translate(-14px,-22px) rotate(8deg)', opacity: 1, offset: .12 },
        { transform: 'translate(' + dx + 'px,' + dy + 'px) rotate(14deg)', opacity: 1, offset: .85 },
        { transform: 'translate(' + (dx * 1.05) + 'px,' + (dy * 1.05) + 'px) rotate(14deg)', opacity: 0, offset: 1 }
      ], { duration: 1700, easing: 'cubic-bezier(.45,.05,.8,.6)', fill: 'both' });
      a.onfinish = function () {
        bird.style.visibility = 'hidden';
        a.cancel();
        bird.classList.remove('fly');
        state = 'away';
        setTimeout(arrive, rand(AWAY_MIN, AWAY_MAX));
      };
    }

    function arrive() {
      state = 'landing';
      const lr = layer.getBoundingClientRect(), r = bird.getBoundingClientRect();
      const sx = (lr.right - r.left) + r.width + 160;      // starts beyond the right edge
      const sy = -(r.top - lr.top) - r.height - 40;
      bird.style.visibility = 'visible';
      bird.classList.add('fly');
      const a = bird.animate([
        { transform: 'translate(' + sx + 'px,' + sy + 'px) rotate(-14deg)', opacity: 0, offset: 0 },
        { opacity: 1, offset: .1 },
        { transform: 'translate(0,0) rotate(0deg)', opacity: 1, offset: 1 }
      ], { duration: 2000, easing: 'cubic-bezier(.2,.65,.3,1)', fill: 'both' });
      a.onfinish = function () {
        a.cancel();
        bird.classList.remove('fly');
        state = 'perched';
        landedAt = performance.now();
      };
    }

    // ---------- cursor / touch near the crow ----------
    let ticking = false, mx = 0, my = 0;
    function check() {
      ticking = false;
      if (state !== 'perched' || !visible || performance.now() - landedAt < 1500) return;
      const r = bird.getBoundingClientRect();
      if (mx > r.left - SCARE_DIST && mx < r.right + SCARE_DIST &&
          my > r.top - SCARE_DIST && my < r.bottom + SCARE_DIST) leave();
    }
    function onPointer(e) {
      mx = e.clientX; my = e.clientY;
      if (!ticking) { ticking = true; requestAnimationFrame(check); }
    }
    section.addEventListener('pointermove', onPointer);
    section.addEventListener('pointerdown', onPointer);
  });
})();
</script>

<script>
(function () {
  function onReady(fn) {
    if (document.readyState !== 'loading') fn();
    else document.addEventListener('DOMContentLoaded', fn);
  }

  onReady(function () {
    const layer = document.getElementById('candleLayer');
    if (!layer) return;
    const section = layer.parentElement;

    const isMobile = window.innerWidth < 768;
    const COUNT = isMobile ? 4 : 7;
    const RELIGHT_MIN = 3500, RELIGHT_MAX = 6500;   // ms before a blown-out candle relights
    const rand = (a, b) => a + Math.random() * (b - a);

    function candleSVG(i, bodyH) {
      const top = 66, bot = top + bodyH;
      const xs = [18.5, 25, 35.5, 42];
      let drips = '';
      const n = 2 + Math.floor(Math.random() * 3);
      for (let k = 0; k < n; k++) {
        const x = xs[Math.floor(Math.random() * xs.length)] + rand(-1, 1);
        const len = rand(18, Math.max(24, bodyH * 0.8));
        const w = rand(2.8, 4.4);
        drips += '<g style="--len:' + len.toFixed(1) + ';--dd:' + rand(8, 15).toFixed(1) + 's;--dl:-' + rand(0, 12).toFixed(1) + 's">' +
          '<path class="cd-drip" d="M' + x.toFixed(1) + ' ' + (top + 1) + ' L' + x.toFixed(1) + ' ' + (top + 1 + len).toFixed(1) + '" stroke="#f1e3bf" stroke-width="' + w.toFixed(1) + '"/>' +
          '<path class="cd-drip" d="M' + (x - w * 0.22).toFixed(1) + ' ' + (top + 2) + ' L' + (x - w * 0.22).toFixed(1) + ' ' + (top + len - 1).toFixed(1) + '" stroke="rgba(255,255,255,.45)" stroke-width="' + (w * 0.28).toFixed(1) + '"/></g>';
      }
      return '<svg viewBox="0 0 60 ' + bot + '" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">' +
        '<defs>' +
          '<linearGradient id="cdW' + i + '" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#f4e9cf"/><stop offset=".35" stop-color="#e2d3ae"/><stop offset=".75" stop-color="#b7a47a"/><stop offset="1" stop-color="#7a6a4a"/></linearGradient>' +
          '<linearGradient id="cdL' + i + '" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="rgba(255,170,60,.5)"/><stop offset="1" stop-color="rgba(255,170,60,0)"/></linearGradient>' +
          '<radialGradient id="cdG' + i + '"><stop offset="0" stop-color="rgba(255,190,90,.55)"/><stop offset="1" stop-color="rgba(255,138,0,0)"/></radialGradient>' +
          '<linearGradient id="cdF' + i + '" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ff7a00"/><stop offset=".55" stop-color="#ffc13a"/><stop offset=".9" stop-color="#fff1b0"/><stop offset="1" stop-color="#7aa6ff"/></linearGradient>' +
        '</defs>' +
        '<ellipse cx="30" cy="' + bot + '" rx="24" ry="4" fill="#c9b890" opacity=".9"/>' +
        '<ellipse cx="30" cy="' + (bot - .5) + '" rx="17" ry="2.4" fill="#e6d6aa"/>' +
        '<rect x="14" y="' + top + '" width="32" height="' + bodyH + '" rx="3" fill="url(#cdW' + i + ')"/>' +
        drips +
        '<ellipse cx="30" cy="' + top + '" rx="16" ry="3.4" fill="#f6e6bd"/>' +
        '<ellipse cx="30" cy="' + (top + .5) + '" rx="12" ry="2.4" fill="#ffd98a" opacity=".9"/>' +
        '<line x1="30" y1="' + top + '" x2="30" y2="57" stroke="#20150a" stroke-width="1.8" stroke-linecap="round"/>' +
        '<g class="cd-gw"><g class="cd-glow">' +
          '<ellipse cx="30" cy="42" rx="46" ry="52" fill="url(#cdG' + i + ')"/>' +
          '<rect x="14" y="' + top + '" width="32" height="' + (bodyH * 0.55).toFixed(1) + '" fill="url(#cdL' + i + ')"/>' +
        '</g></g>' +
        '<g class="cd-lean"><g class="cd-flame">' +
          '<path d="M30 58 C23 54 21 46 26 38 C28 34 29 30 30 20 C32 30 36 34 37 40 C39 48 37 54 30 58 Z" fill="url(#cdF' + i + ')"/>' +
          '<path d="M30 57 C26 54 25 49 28 44 C29 42 30 40 30 36 C31 40 34 43 34 48 C34 53 33 55 30 57 Z" fill="#fff6d0" opacity=".9"/>' +
        '</g></g>' +
        '<circle class="cd-wk" cx="30" cy="58" r="1" fill="none"/>' +
      '</svg>';
    }

    const shelf = document.createElement('div');
    shelf.className = 'cd-shelf';
    layer.appendChild(shelf);

    const candles = [];
    for (let i = 0; i < COUNT; i++) {
      const w = rand(isMobile ? 38 : 44, isMobile ? 52 : 64);
      const bodyH = rand(50, 150);
      const el = document.createElement('div');
      el.className = 'cd';
      el.style.width = w + 'px';
      el.style.left = ((i + 0.5) / COUNT * 100 + rand(-3, 3)) + '%';
      el.style.marginLeft = (-w / 2) + 'px';
      el.innerHTML = candleSVG(i, bodyH);
      el.querySelector('.cd-glow').style.setProperty('--gl', rand(1.6, 2.8).toFixed(2) + 's');
      el.querySelector('.cd-flame').style.setProperty('--ff', rand(0.6, 1.1).toFixed(2) + 's');
      layer.appendChild(el);
      candles.push({
        el: el, lean: el.querySelector('.cd-lean'), wick: el.querySelector('.cd-wk'),
        ang: 0, tgt: 0, ph: rand(0, 6.28), out: false, litAt: 0
      });
    }

    // ---------- smoke ----------
    function smoke(c, ms) {
      const end = performance.now() + ms;
      const iv = setInterval(function () {
        if (performance.now() > end) { clearInterval(iv); return; }
        const lr = layer.getBoundingClientRect(), wr = c.wick.getBoundingClientRect();
        const x = wr.left - lr.left, y = wr.top - lr.top;
        const p = document.createElement('div');
        p.className = 'cd-smoke';
        const s = rand(8, 16);
        p.style.width = p.style.height = s + 'px';
        p.style.left = (x - s / 2) + 'px';
        p.style.top = (y - s / 2) + 'px';
        layer.appendChild(p);
        const h = rand(90, 150), d1 = rand(-14, 14), d2 = rand(-22, 22), d3 = rand(-30, 30);
        const a = p.animate([
          { transform: 'translate(0,0) scale(.4)', opacity: 0 },
          { transform: 'translate(' + d1 + 'px,' + (-h * 0.3) + 'px) scale(.9)', opacity: .7, offset: .25 },
          { transform: 'translate(' + d2 + 'px,' + (-h * 0.65) + 'px) scale(1.6)', opacity: .4, offset: .65 },
          { transform: 'translate(' + d3 + 'px,' + (-h) + 'px) scale(2.4)', opacity: 0 }
        ], { duration: rand(2200, 3200), easing: 'ease-out' });
        a.onfinish = function () { p.remove(); };
      }, 110);
    }

    function blowOut(c) {
      if (c.out) return;
      c.out = true;
      c.el.classList.add('out');
      smoke(c, 2600);
      setTimeout(function () {
        c.out = false;
        c.el.classList.remove('out');
        c.litAt = performance.now();
      }, rand(RELIGHT_MIN, RELIGHT_MAX));
    }

    // ---------- flames lean in the breeze (only while visible) ----------
    let visible = true, running = false, last = 0;
    function frame(now) {
      const dt = Math.min(0.033, (now - last) / 1000);
      last = now;
      const t = now / 1000;
      candles.forEach(function (c) {
        const idle = Math.sin(t * 1.3 + c.ph) * 1.8 + Math.sin(t * 0.7 + c.ph * 2) * 1.2;
        c.ang += (c.tgt + idle - c.ang) * Math.min(1, dt * 8);
        c.tgt *= Math.pow(0.02, dt);
        c.lean.style.transform = 'rotate(' + c.ang.toFixed(2) + 'deg)';
      });
      if (visible && !document.hidden) requestAnimationFrame(frame);
      else running = false;
    }
    function start() { if (running) return; running = true; last = performance.now(); requestAnimationFrame(frame); }
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        visible = entries[entries.length - 1].isIntersecting;
        if (visible) start();
      }).observe(section);
    }
    start();
    document.addEventListener('visibilitychange', function () { if (!document.hidden) start(); });

    // ---------- cursor gusts ----------
    let px = 0, py = 0, pt = 0;
    section.addEventListener('pointermove', function (e) {
      const now = performance.now(), dt = (now - pt) / 1000;
      if (pt && dt > 0 && dt < 0.15) {
        const vx = (e.clientX - px) / dt, vy = (e.clientY - py) / dt, sp = Math.hypot(vx, vy);
        if (sp > 200) {
          candles.forEach(function (c) {
            if (c.out) return;
            const r = c.wick.getBoundingClientRect();
            const d = Math.hypot(e.clientX - (r.left + r.width / 2), e.clientY - (r.top + r.height / 2));
            if (d > 90) return;
            const g = Math.min(1, sp / 1500) * (1 - d / 90);
            c.tgt = Math.max(-38, Math.min(38, c.tgt + (vx > 0 ? 1 : -1) * g * 40));
            if (sp > 1100 && d < 70 && now - c.litAt > 1500) blowOut(c);   // fast and close = blown out
          });
        }
      }
      px = e.clientX; py = e.clientY; pt = now;
    });
    section.addEventListener('pointerleave', function () { pt = 0; });
  });
})();
</script>

<script>
(function () {
  function onReady(fn) {
    if (document.readyState !== 'loading') fn();
    else document.addEventListener('DOMContentLoaded', fn);
  }

  onReady(function () {
    const layer = document.getElementById('flashLayer');
    if (!layer) return;
    const section = layer.parentElement;

    const isMobile = window.innerWidth < 768;
    const BASE_R = isMobile ? 130 : 190;        // flashlight radius (px)
    const OFFER_TOP = 'UP TO', OFFER_MAIN = '40% OFF';
    const rand = (a, b) => a + Math.random() * (b - a);
    const RIM = 'rgba(168,85,247,.85)';

    // ---------- wall + painted offer ----------
    layer.innerHTML =
      '<div class="fl-wall"></div>' +
      '<div class="fl-offer"><span class="fl-offer-top">' + OFFER_TOP + '</span><span class="fl-offer-main">' + OFFER_MAIN + '</span></div>';

    // ---------- skulls (revealed + sockets flare when lit) ----------
    const SKULL_SVG =
      '<svg viewBox="0 0 100 112" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">' +
        '<path d="M50 4 C23 4 9 24 11 47 C12 59 17 66 24 70 L24 88 C24 93 28 96 33 96 L67 96 C72 96 76 93 76 88 L76 70 C83 66 88 59 89 47 C91 24 77 4 50 4 Z" fill="#e4d9bd"/>' +
        '<path d="M72 10 C84 20 90 34 88 48 C87 58 83 64 76 69 L76 88 C76 93 72 96 67 96 L62 96 C70 90 72 80 71 66 C80 54 82 30 72 10 Z" fill="rgba(90,65,30,.30)"/>' +
        '<path d="M58 6 L54 18 L60 26 L56 34" stroke="rgba(70,50,25,.7)" stroke-width="1.4" fill="none"/>' +
        '<ellipse cx="34" cy="52" rx="12" ry="13" fill="#0b0508" transform="rotate(-8 34 52)"/>' +
        '<ellipse cx="66" cy="52" rx="12" ry="13" fill="#0b0508" transform="rotate(8 66 52)"/>' +
        '<circle class="fl-ember" cx="35" cy="54" r="4" fill="#ff7a00"/><circle class="fl-ember" cx="65" cy="54" r="4" fill="#ff7a00"/>' +
        '<path d="M50 64 L43 79 L50 75 L57 79 Z" fill="#0b0508"/>' +
        '<rect x="30" y="82" width="40" height="16" rx="3" fill="#d6cba9"/>' +
        '<path d="M38 82 V98 M46 82 V98 M54 82 V98 M62 82 V98" stroke="rgba(60,40,20,.75)" stroke-width="1.6"/>' +
      '</svg>';

    const skulls = [];
    [[0.16, 0.62], [0.84, 0.34]].forEach(function (p) {
      const el = document.createElement('div');
      el.className = 'fl-skull';
      el.style.width = (isMobile ? 54 : rand(70, 88)) + 'px';
      el.style.left = (p[0] * 100) + '%';
      el.style.top = (p[1] * 100) + '%';
      el.innerHTML = SKULL_SVG;
      layer.appendChild(el);
      skulls.push({ el: el, xp: p[0], yp: p[1] });
    });

    // ---------- sleeping bats ----------
    const FOLDED =
      '<svg viewBox="0 0 40 72" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">' +
        '<path d="M20 2 L20 10" stroke="' + RIM + '" stroke-width="2.4" stroke-linecap="round"/>' +
        '<path d="M20 8 C33 18 33 46 20 64 C7 46 7 18 20 8 Z" fill="#000" stroke="' + RIM + '" stroke-width="1.4"/>' +
        '<path d="M20 14 L20 58" stroke="rgba(168,85,247,.35)" stroke-width="1"/>' +
        '<path d="M14 60 L12 70 L18 64 Z M26 60 L28 70 L22 64 Z" fill="#000" stroke="' + RIM + '" stroke-width="1"/>' +
      '</svg>';
    const OPEN =
      '<svg viewBox="0 0 100 60" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">' +
        '<g fill="#000">' +
          '<path class="fw" d="M46 28 C34 14 16 8 2 14 C8 20 10 26 8 34 C14 30 18 32 22 40 C28 34 34 36 40 44 C42 38 44 34 46 28 Z"/>' +
          '<g transform="translate(100,0) scale(-1,1)"><path class="fw" d="M46 28 C34 14 16 8 2 14 C8 20 10 26 8 34 C14 30 18 32 22 40 C28 34 34 36 40 44 C42 38 44 34 46 28 Z"/></g>' +
          '<ellipse cx="50" cy="32" rx="6" ry="10"/><circle cx="50" cy="20" r="6.5"/>' +
          '<polygon points="44,19 44.5,7 49.5,15"/><polygon points="56,19 55.5,7 50.5,15"/>' +
        '</g>' +
        '<g fill="#ff8a00"><circle cx="47.5" cy="20" r="1.7"/><circle cx="52.5" cy="20" r="1.7"/></g>' +
      '</svg>';

    const bats = [];
    [0.22, 0.52, 0.78].forEach(function (xp) {
      const w = isMobile ? 26 : rand(32, 42);
      const el = document.createElement('div');
      el.className = 'fl-hbat';
      el.style.width = w + 'px';
      el.style.left = (xp * 100) + '%';
      el.style.marginLeft = (-w / 2) + 'px';
      el.innerHTML = FOLDED;
      layer.appendChild(el);
      bats.push({ el: el, xp: xp, w: w, state: 'hang' });
    });

    // ---------- darkness + eyes in the dark ----------
    const dark = document.createElement('div');
    dark.className = 'fl-dark';
    layer.appendChild(dark);

    const EYES_SVG =
      '<svg viewBox="0 0 44 16" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">' +
        '<ellipse cx="11" cy="8" rx="7" ry="4.5" fill="#ff8a00"/><ellipse cx="33" cy="8" rx="7" ry="4.5" fill="#ff8a00"/>' +
        '<ellipse cx="11" cy="8" rx="1.6" ry="4" fill="#1a0600"/><ellipse cx="33" cy="8" rx="1.6" ry="4" fill="#1a0600"/>' +
      '</svg>';
    const eyes = [];
    for (let i = 0; i < (isMobile ? 4 : 6); i++) {
      const el = document.createElement('div');
      el.className = 'fl-eyes';
      el.style.width = rand(26, 44) + 'px';
      el.innerHTML = EYES_SVG;
      el.querySelector('svg').style.animationDelay = (-rand(0, 5)).toFixed(2) + 's';
      layer.appendChild(el);
      const e = { el: el, xp: 0, yp: 0, state: 'on' };
      place(e);
      eyes.push(e);
    }
    function place(e) {
      e.xp = rand(0.06, 0.94); e.yp = rand(0.1, 0.9);
      e.el.style.left = (e.xp * 100) + '%';
      e.el.style.top = (e.yp * 100) + '%';
    }
    function hideEyes(e) {
      e.state = 'gone';
      e.el.classList.add('gone');
      setTimeout(function () {
        place(e);
        e.el.classList.remove('gone');
        e.state = 'on';
      }, rand(2500, 6000));
    }

    // ---------- bats fly off ----------
    function fly(b) {
      b.state = 'fly';
      b.el.style.opacity = '0';
      const W = layer.clientWidth || window.innerWidth, H = layer.clientHeight || 440;
      const f = document.createElement('div');
      f.className = 'fl-fbat';
      const w = b.w * 1.7;
      f.style.width = w + 'px';
      f.style.left = (b.xp * W - w / 2) + 'px';
      f.style.top = '10px';
      f.innerHTML = OPEN;
      layer.appendChild(f);
      const dx = (Math.random() < 0.5 ? -1 : 1) * W * 0.9;
      const a = f.animate([
        { transform: 'translate(0,0) scale(.7)', opacity: 0, offset: 0 },
        { opacity: 1, offset: .1 },
        { transform: 'translate(' + (dx * 0.25) + 'px,' + (H * 0.35) + 'px) scale(1)', opacity: 1, offset: .35 },
        { transform: 'translate(' + dx + 'px,' + (-H * 0.05) + 'px) scale(1)', opacity: 1, offset: .95 },
        { transform: 'translate(' + dx + 'px,' + (-H * 0.05) + 'px) scale(1)', opacity: 0, offset: 1 }
      ], { duration: 2400, easing: 'linear' });
      a.onfinish = function () {
        f.remove();
        setTimeout(function () { b.state = 'hang'; b.el.style.opacity = '1'; }, rand(6000, 11000));
      };
    }

    // ---------- the light ----------
    let lx = 0, ly = 0, tx = 0, ty = 0, inside = false, lastMove = 0, first = true;
    function target(e) {
      const r = section.getBoundingClientRect();
      tx = e.clientX - r.left; ty = e.clientY - r.top;
      inside = true; lastMove = performance.now();
    }
    section.addEventListener('pointermove', target);
    section.addEventListener('pointerdown', target);
    section.addEventListener('pointerleave', function () { inside = false; });

    let visible = true, running = false, last = 0;
    function frame(now) {
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      const t = now / 1000;
      const W = layer.clientWidth || window.innerWidth, H = layer.clientHeight || 440;

      if (first) { lx = tx = W / 2; ly = ty = H / 2; first = false; }
      if (!inside || now - lastMove > 2500) {            // wander on its own
        tx = W * (0.5 + 0.38 * Math.sin(t * 0.45));
        ty = H * (0.5 + 0.34 * Math.sin(t * 0.61 + 1));
      }
      lx += (tx - lx) * Math.min(1, dt * 7);
      ly += (ty - ly) * Math.min(1, dt * 7);

      const R = BASE_R * (1 + 0.03 * Math.sin(t * 9) + 0.02 * Math.sin(t * 23.7));   // flicker
      const at = ' at ' + lx.toFixed(1) + 'px ' + ly.toFixed(1) + 'px, ';
      dark.style.background =
        'radial-gradient(circle ' + R.toFixed(0) + 'px' + at + 'rgba(255,160,60,.16) 0, rgba(255,160,60,0) ' + R.toFixed(0) + 'px), ' +
        'radial-gradient(circle ' + R.toFixed(0) + 'px' + at + 'rgba(0,0,0,0) 0, rgba(0,0,0,0) ' + (R * 0.28).toFixed(0) + 'px, rgba(0,0,0,.6) ' + (R * 0.68).toFixed(0) + 'px, rgba(0,0,0,.965) ' + R.toFixed(0) + 'px)';

      // things react to the light
      skulls.forEach(function (s) {
        s.el.classList.toggle('lit', Math.hypot(s.xp * W - lx, s.yp * H - ly) < R * 0.8);
      });
      eyes.forEach(function (e) {
        if (e.state === 'on' && Math.hypot(e.xp * W - lx, e.yp * H - ly) < R * 0.9) hideEyes(e);
      });
      bats.forEach(function (b) {
        if (b.state === 'hang' && Math.hypot(b.xp * W - lx, 30 - ly) < R * 0.75) fly(b);
      });

      if (visible && !document.hidden) requestAnimationFrame(frame);
      else running = false;
    }
    function start() { if (running) return; running = true; last = performance.now(); requestAnimationFrame(frame); }
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        visible = entries[entries.length - 1].isIntersecting;
        if (visible) start();
      }).observe(section);
    }
    start();
    document.addEventListener('visibilitychange', function () { if (!document.hidden) start(); });
  });
})();
</script>

