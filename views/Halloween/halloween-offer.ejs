    const MAX_FLYING = isMobile ? 4 : 7;

    function launch() {
      // starts at her hand at the moment of release
      const h = hand.getBoundingClientRect();
      const w = witch.getBoundingClientRect();
      const x0 = h.width ? h.left + h.width / 2 : w.left + w.width * 0.7;
      const y0 = h.width ? h.top + h.height / 2 : w.top + w.height * 0.55;
      if (x0 < -50 || x0 > window.innerWidth + 50) return;   // she is off screen

      const isSkull = Math.random() < 0.4;
      const item = document.createElement('div');
      item.className = 'throw-item ' + (isSkull ? 'throw-skull' : 'throw-bat');

      const base = isMobile ? 46 : 70;
      item.style.width = (isSkull ? base * 0.8 : base * 1.3) + 'px';
      item.innerHTML = isSkull ? SKULL_SVG : BAT_SVG;
      throwLayer.appendChild(item);

      // lands somewhere around the middle of the screen
      const tx = window.innerWidth  * rand(0.2, 0.8);
      const ty = window.innerHeight * rand(0.2, 0.7);
      const endScale = (isSkull ? rand(5, 8) : rand(6, 10)) * (isMobile ? 0.7 : 1);
      const spin = (Math.random() < 0.5 ? -1 : 1) * rand(180, 540);
      const dur = rand(750, 1150);

      const T = (x, y, s, rot) =>
        'translate(' + x + 'px,' + y + 'px) translate(-50%,-50%) scale(' + s + ') rotate(' + rot + 'deg)';

      flying++;
      const anim = item.animate([
        { transform: T(x0, y0, 0.15, 0), opacity: 0, offset: 0 },
        { transform: T(x0 + (tx - x0) * 0.12, y0 + (ty - y0) * 0.12 - 20, 0.35, spin * 0.12), opacity: 1, offset: 0.1 },
        { transform: T(tx, ty, endScale, spin), opacity: 1, offset: 0.88 },
        { transform: T(tx, ty, endScale * 1.25, spin * 1.05), opacity: 0, offset: 1 }
      ], { duration: dur, easing: 'cubic-bezier(.45,.05,.9,.6)', fill: 'forwards' });

      anim.onfinish = function () {
        flying--;
        item.remove();
        if (isSkull) {                                   // impact flash for skulls
          const hit = document.createElement('div');
          hit.className = 'throw-hit';
          hit.style.left = tx + 'px';
          hit.style.top = ty + 'px';
