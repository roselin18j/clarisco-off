      <script>
  if (document.body.classList.contains("hallowen-pg")) {
    const canTrail = matchMedia("(pointer: fine)").matches;

    if (canTrail) {
      let mx = 0, my = 0;
      let active = false;
      let overBlocked = false;
      let flip = false;

      const OFFSET_X = -48;
      const OFFSET_Y = 8;
      const NO_TRAIL = "a, button, [role='button'], input[type='submit'], .btn-close, .float-hallowen";

      document.addEventListener("mousemove", (e) => {
        mx = e.clientX;
        my = e.clientY;
        active = true;

        const nowBlocked = !!e.target.closest(NO_TRAIL);

        // lets CSS react (hide a custom cursor element, etc.)
        document.body.classList.toggle("over-link", nowBlocked);

        if (nowBlocked && !overBlocked) {
          document.querySelectorAll(".halloween-star").forEach((s) => s.remove());
        }
        overBlocked = nowBlocked;
      });

      document.documentElement.addEventListener("mouseleave", () => { active = false; });
      document.documentElement.addEventListener("mouseenter", () => { active = true; });

      function spawnStar() {
        const size = 10 + Math.random() * 10;
        const star = document.createElement("div");
        flip = !flip;
        star.className = "halloween-star " + (flip ? "violet" : "orange");

        star.style.width = size + "px";
        star.style.height = size + "px";
        star.style.left = (mx + OFFSET_X - size / 2 + (Math.random() * 14 - 7)) + "px";
        star.style.top = (my + OFFSET_Y - size / 2 + (Math.random() * 10 - 5)) + "px";
        star.style.setProperty("--dx", (Math.random() * 40 - 20) + "px");
        star.style.setProperty("--dy", (-50 - Math.random() * 50) + "px");
        star.style.animationDuration = (1.3 + Math.random() * 0.8) + "s";

        document.body.appendChild(star);
        star.addEventListener("animationend", () => star.remove());
      }

      setInterval(() => {
        if (!active || overBlocked || document.hidden) return;
        if (document.querySelectorAll(".halloween-star").length > 40) return;
        spawnStar();
      }, 110);
    }
  }
</script>

                <script>
                    const TZ = "Asia/Kolkata";

                    // Current year in IST
                    const istYear = Number(
                        new Intl.DateTimeFormat("en-US", { timeZone: TZ, year: "numeric" }).format(new Date())
                    );

                    // Oct 31 of the current IST year, 3:13 PM IST
                    const targetDate = new Date(`${istYear}-11-02T23:59:00+05:30`).getTime();

                    let countdownInterval;

                    function setText(id, value, pad = true) {
                        const el = document.getElementById(id);
                        if (el) el.innerText = pad ? String(value).padStart(2, "0") : String(value);
                    }

                    function updateCounter() {
                        const distance = targetDate - Date.now();

                        if (distance <= 0) {
                            ["days", "hours", "minutes", "seconds"].forEach((id) => setText(id, 0));
                            setText("total-hours", 0, false);
                            clearInterval(countdownInterval);
                            return;
                        }

                        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
                        const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                        const seconds = Math.floor((distance % (1000 * 60)) / 1000);
                        const totalHours = Math.floor(distance / (1000 * 60 * 60));

                        setText("days", days);
                        setText("hours", hours);
                        setText("minutes", minutes);
                        setText("seconds", seconds);
                        setText("total-hours", totalHours, false); // no leading zero
                    }

                    updateCounter();
                    countdownInterval = setInterval(updateCounter, 1000);
                </script>


                <script>
                    document.addEventListener("DOMContentLoaded", function () {
                        const section = document.querySelector(".hh-block");
                        if (!section) return;

                        const counters = section.querySelectorAll(".counter-value");

                        counters.forEach((counter) => {
                            const originalText = counter.textContent.trim();
                            const target = parseInt(originalText.replace(/\D/g, ""), 10) || 0;
                            const hasPlus = originalText.includes("+");
                            const duration = 1800;
                            let startTime = null;

                            function animate(currentTime) {
                                if (!startTime) startTime = currentTime;

                                const elapsed = currentTime - startTime;
                                const progress = Math.min(elapsed / duration, 1);
                                const value = Math.floor(progress * target);

                                counter.textContent = hasPlus ? `${value}+` : value;

                                if (progress < 1) {
                                    requestAnimationFrame(animate);
                                } else {
                                    counter.textContent = hasPlus ? `${target}+` : target;
                                }
                            }

                            requestAnimationFrame(animate);
                        });
                    });
                </script>
<script>
