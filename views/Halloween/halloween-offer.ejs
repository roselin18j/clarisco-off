          <polygon points="44,19 44.5,7 49.5,15"/>
          <polygon points="56,19 55.5,7 50.5,15"/>
        </g>
        <g fill="#ff8a00" style="filter: drop-shadow(0 0 2px #ff8a00)">
          <circle cx="47.5" cy="20" r="1.7"/>
          <circle cx="52.5" cy="20" r="1.7"/>
        </g>
      </svg>`;

    // thrown skull (aged bone, dark sockets with a faint ember inside)
    const SKULL_SVG = `
      <svg viewBox="0 0 100 112" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M50 4 C23 4 9 24 11 47 C12 59 17 66 24 70 L24 88 C24 93 28 96 33 96 L67 96 C72 96 76 93 76 88 L76 70 C83 66 88 59 89 47 C91 24 77 4 50 4 Z" fill="#e4d9bd"/>
        <path d="M72 10 C84 20 90 34 88 48 C87 58 83 64 76 69 L76 88 C76 93 72 96 67 96 L62 96 C70 90 72 80 71 66 C80 54 82 30 72 10 Z" fill="rgba(90,65,30,.30)"/>
        <path d="M30 12 C22 18 17 28 16 38" stroke="rgba(255,255,255,.4)" stroke-width="3" fill="none" stroke-linecap="round"/>
        <path d="M58 6 L54 18 L60 26 L56 34" stroke="rgba(70,50,25,.7)" stroke-width="1.4" fill="none"/>
        <ellipse cx="34" cy="52" rx="12" ry="13" fill="#0b0508" transform="rotate(-8 34 52)"/>
        <ellipse cx="66" cy="52" rx="12" ry="13" fill="#0b0508" transform="rotate(8 66 52)"/>
        <circle cx="35" cy="54" r="3.2" fill="#ff7a00" opacity=".85"/>
        <circle cx="65" cy="54" r="3.2" fill="#ff7a00" opacity=".85"/>
        <path d="M50 64 L43 79 L50 75 L57 79 Z" fill="#0b0508"/>
        <rect x="30" y="82" width="40" height="16" rx="3" fill="#d6cba9"/>
        <path d="M38 82 V98 M46 82 V98 M54 82 V98 M62 82 V98" stroke="rgba(60,40,20,.75)" stroke-width="1.6"/>
        <path d="M30 90 H70" stroke="rgba(60,40,20,.55)" stroke-width="1.2"/>
      </svg>`;

    const rand = (a, b) => a + Math.random() * (b - a);
    const calmColors  = ['#ff8a00', '#ffb347', '#ff5a00', '#ffd27a'];
    const angryColors = ['#ff2a00', '#ff4d00', '#ff6a00', '#ff8a00'];

    // set to true if you want to respect the visitor's "reduce motion" setting
    const reduceMotion = false;

    const isMobile = window.innerWidth < 768;
    const size = isMobile ? 110 : 170;
    const WITCH_TOP = 40;   // px from the top of the section; adjust to cross the moon

    // ---------- build the witch ----------
    const witch = document.createElement('div');
    witch.className = 'witch';
    witch.style.width = size + 'px';
    witch.style.top = WITCH_TOP + 'px';
    witch.style.setProperty('--size', size + 'px');
    witch.innerHTML = '<div class="witch-bob">' + WITCH_SVG + '<span class="witch-tail"></span></div>';
    layer.appendChild(witch);

    const tail = witch.querySelector('.witch-tail');
    const arm  = witch.querySelector('.witch-arm');
    const hand = witch.querySelector('.witch-hand');

    // arm swings around the shoulder
    arm.style.transformBox = 'view-box';
    arm.style.transformOrigin = '106px 40px';

    // full-screen overlay for the thrown things
    const throwLayer = document.createElement('div');
