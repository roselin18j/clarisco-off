    }

    function throwOne() {
      if (reduceMotion || flying >= MAX_FLYING || !visible || document.hidden) return;
      const w = witch.getBoundingClientRect();
      if (w.right < 0 || w.left > window.innerWidth) return;

      // arm: wind back, then snap forward
      if (arm.animate) {
        arm.animate([
          { transform: 'rotate(0deg)',   offset: 0 },
          { transform: 'rotate(-80deg)', offset: 0.35 },
          { transform: 'rotate(40deg)',  offset: 0.6 },
          { transform: 'rotate(0deg)',   offset: 1 }
        ], { duration: 340, easing: 'ease-in-out' });
      }
      // release the object at the moment the arm snaps forward
      setTimeout(launch, 200);
    }

    // ---------- hover / touch: get angry and start throwing ----------
    let angry = false, calmTimer = null, throwTimer = null, ticking = false, mx = 0, my = 0;
    const PAD = 25;   // extra px around her body that still counts as hovering

    function setAngry(on) {
      if (on === angry) return;
      angry = on;
      witch.classList.toggle('angry', on);
      if (on) {
        throwOne();
        throwTimer = setInterval(throwOne, 480);
      } else {
        clearInterval(throwTimer);
        throwTimer = null;
      }
    }

    function check() {
      ticking = false;
      const r = witch.getBoundingClientRect();
      const over = mx > r.left - PAD && mx < r.right + PAD &&
                   my > r.top - PAD  && my < r.bottom + PAD;
      if (!over) return;
      setAngry(true);
      clearTimeout(calmTimer);
      calmTimer = setTimeout(function () { setAngry(false); }, 1100);
    }

    function onPointer(e) {
      mx = e.clientX; my = e.clientY;
      if (!ticking) { ticking = true; requestAnimationFrame(check); }
    }
    section.addEventListener('pointermove', onPointer);
    section.addEventListener('pointerdown', onPointer);

    // ---------- spark trail (triple and red while angry) ----------
    setInterval(function () {
      if (!visible || document.hidden) return;

      const t = tail.getBoundingClientRect();
