                    document.querySelectorAll(".music-card audio").forEach(a => a.pause());

                    document.querySelectorAll(".play-btn").forEach(btn => {
                        btn.innerHTML = `<i class="fa-solid fa-play"></i>`;
                    });

                    // ✅ RESUME AUTOPLAY ON SWIPE
                    if (this.autoplay) {
                        this.autoplay.start();
                    }
                }
            }
        });

        buttons.forEach((btn, index) => {
            btn.addEventListener("click", () => {
                window.mainSwiper.slideToLoop
                    ? window.mainSwiper.slideToLoop(index)
                    : window.mainSwiper.slideTo(index);

                setActive(index);
            });
        });

        function setActive(activeIndex) {
            buttons.forEach((btn, i) => {
                btn.classList.toggle("active", i === activeIndex);
            });
        }

        /* =========================
           ONLY ADD THIS PART
        ========================= */
        document.querySelectorAll(".music-card .play-btn").forEach(btn => {
            btn.addEventListener("click", () => {
                // ✅ STOP AUTOPLAY WHEN USER PLAYS AUDIO
                if (window.mainSwiper?.autoplay) {
                    window.mainSwiper.autoplay.stop();
                }
            });
        });

    });
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const totalInnerSwipers = 5; // change if more slides

        // Hidden hero slides (every category except the first slide) carry
        // data-defer-src: they are fetched after load / first interaction so they
        // don't compete with the visible hero image. Swiper's loop clones copy the
        // attribute, so the clones are swapped too.
        let heroImagesLoaded = false;
        function loadDeferredHeroImages() {
            if (heroImagesLoaded) return;
            heroImagesLoaded = true;
            document.querySelectorAll("img[data-defer-src]").forEach(function (img) {
                img.src = img.getAttribute("data-defer-src");
                img.removeAttribute("data-defer-src");
            });
        }
        ["scroll", "pointerdown", "keydown", "touchstart"].forEach(function (eventName) {
            window.addEventListener(eventName, loadDeferredHeroImages, { once: true, passive: true });
        });
        if (document.readyState === "complete") loadDeferredHeroImages();
        else window.addEventListener("load", loadDeferredHeroImages, { once: true });

        // Inner banner sliders stay paused until the visitor interacts (or 8s after
        // load). Slides 2/3 render larger than slide 1 on mobile, so an early
        // auto-advance made the browser re-report LCP on the new slide (~9s).
        const innerSwipers = [];
        let innerAutoplayStarted = false;
        function startInnerAutoplay() {
            if (innerAutoplayStarted) return;
            innerAutoplayStarted = true;
            innerSwipers.forEach(function (s) { if (s.autoplay) s.autoplay.start(); });
        }
        ["scroll", "pointerdown", "keydown", "touchstart"].forEach(function (eventName) {
            window.addEventListener(eventName, startInnerAutoplay, { once: true, passive: true });
        });
        window.addEventListener("load", function () { setTimeout(startInnerAutoplay, 8000); }, { once: true });

        for (let i = 1; i <= totalInnerSwipers; i++) {

            const swiperClass = `.mySwiperBann2_${i}`;
            const paginationClass = `.swiper-page2_${i}`;

            // skip if swiper not present (important for dynamic slides)
            if (!document.querySelector(swiperClass)) continue;

            innerSwipers.push(new Swiper(swiperClass, {
                observer: false,
                observeParents: false,
                slidesPerView: 1,
                spaceBetween: 20,
                loop: true,

                autoplay: {
                    delay: 4000,
                    disableOnInteraction: false,
                },

                pagination: {
                    el: paginationClass,
                    clickable: true,
                },

                on: {
                    init: function () {
                        updateBullets(this, paginationClass);
                        if (!innerAutoplayStarted && this.autoplay) this.autoplay.stop();
                    },
                    slideChange: function () {
                        updateBullets(this, paginationClass);
                    }
                }
            }));
            // Belt and braces: Swiper versions differ in when autoplay starts.
            const created = innerSwipers[innerSwipers.length - 1];
            if (!innerAutoplayStarted && created.autoplay) created.autoplay.stop();
        }

        function updateBullets(swiper, paginationClass) {
            const bullets = document.querySelectorAll(`${paginationClass} .swiper-pagination-bullet`);

            bullets.forEach((b, i) => {
                b.classList.remove("filled");

                if (i < swiper.realIndex) {
                    b.classList.add("filled");
                }
            });
        }

    });
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        document.querySelectorAll(".music-card").forEach((card) => {

            const audio = card.querySelector("audio");
            const playBtn = card.querySelector(".play-btn");
            const timeDisplay = card.querySelector(".time");
            const lyrics = card.querySelectorAll(".lyrics-container p");
            const container = card.querySelector(".lyrics-container");

            let currentActiveIndex = -1;

            playBtn.addEventListener("click", () => {

                document.querySelectorAll(".music-card audio").forEach(a => {
                    if (a !== audio) a.pause();
                });

                document.querySelectorAll(".music-card .play-btn").forEach(btn => {
                    if (btn !== playBtn) btn.innerHTML = `<i class="fa-solid fa-play"></i>`;
                });

                if (audio.paused) {
                    audio.play().catch(() => { });
                    playBtn.innerHTML = `<i class="fa-solid fa-pause"></i>`;
                } else {
                    audio.pause();
                    playBtn.innerHTML = `<i class="fa-solid fa-play"></i>`;
                }
            });

            audio.addEventListener("ended", () => {
                playBtn.innerHTML = `<i class="fa-solid fa-play"></i>`;
            });

            audio.addEventListener("play", () => {
                currentActiveIndex = -1;
                lyrics.forEach(line => line.classList.remove("active"));
            });

            audio.addEventListener("timeupdate", () => {

                if (!audio.duration) return;

                const remaining = audio.duration - audio.currentTime;
                const min = Math.floor(remaining / 60);
                const sec = Math.floor(remaining % 60);

                timeDisplay.textContent = `-${min}:${sec < 10 ? "0" : ""}${sec}`;

                lyrics.forEach((line, index) => {

                    const time = parseFloat(line.dataset.time);
                    const nextTime = lyrics[index + 1]
                        ? parseFloat(lyrics[index + 1].dataset.time)
                        : Infinity;

                    if (audio.currentTime >= time && audio.currentTime < nextTime) {

                        if (currentActiveIndex !== index) {

                            if (currentActiveIndex !== -1) {
                                lyrics[currentActiveIndex].classList.remove("active");
                            }

                            line.classList.add("active");
                            currentActiveIndex = index;

                            container.scrollTo({
                                top: line.offsetTop - container.clientHeight / 2,
                                behavior: "smooth"
                            });
                        }
                    }
                });
            });

        });

    });
</script>