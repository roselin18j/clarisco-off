                description: "Sending money between countries is slow and expensive, with unpredictable fees." }, {
                title: "Currency volatility" ,
                description: "Users and businesses struggle to protect value when local currencies swing." }, {
                title: "Limited access" ,
                description: "Many people have patchy internet, basic phones or no formal credit history." }, {
                title: "Legacy technology" ,
                description: "Banks and lenders carry ageing systems that slow down new products." } ]; %>

