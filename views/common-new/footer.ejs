          <script>
            document.addEventListener('DOMContentLoaded', function () {
              const col = document.querySelector('.blog-sidebar-col');
              if (!col) return;

              const inner = document.createElement('div');
              while (col.firstChild) inner.appendChild(col.firstChild);
              col.appendChild(inner);
              col.style.position = 'relative';

              const HEADER = 90;  // fixed header height + gap
              const GAP = 20;     // space left at the bottom of the screen

              function update() {
                if (window.innerWidth < 992) { inner.style.cssText = ''; return; }

                const vh = window.innerHeight;
                const cs = getComputedStyle(col);
                const padL = parseFloat(cs.paddingLeft);
                const padR = parseFloat(cs.paddingRight);
                const width = col.clientWidth - padL - padR;
                const rect = col.getBoundingClientRect();

                inner.style.width = width + 'px';
                const h = inner.offsetHeight;

                // where the sidebar's top should be while fixed
                // short sidebar: just under the header
                // tall sidebar: its bottom touches the bottom of the screen
                const stickTop = (h <= vh - HEADER - GAP) ? HEADER : (vh - GAP - h);

                if (rect.top >= stickTop) {
                  // normal position
                  inner.style.position = 'relative';
                  inner.style.top = '0';
                  inner.style.bottom = 'auto';
                  inner.style.left = '0';
                } else if (rect.bottom - h <= stickTop) {
                  // end of the article: rest at the bottom of the column
                  inner.style.position = 'absolute';
                  inner.style.top = 'auto';
                  inner.style.bottom = '0';
                  inner.style.left = padL + 'px';
                } else {
                  // fixed while scrolling
                  inner.style.position = 'fixed';
                  inner.style.top = stickTop + 'px';
                  inner.style.bottom = 'auto';
                  inner.style.left = (rect.left + padL) + 'px';
                }
              }

              let ticking = false;
              window.addEventListener('scroll', function () {
                if (!ticking) {
                  requestAnimationFrame(function () { update(); ticking = false; });
                  ticking = true;
                }
              }, { passive: true });

              window.addEventListener('resize', update);
              window.addEventListener('load', update);
              update();
            });
          </script>


