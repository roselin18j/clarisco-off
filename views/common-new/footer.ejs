            // The animated banner (~1 MB) is swapped in only after the page has
            // loaded or the visitor interacts, so it never competes with the hero.
            (function () {
              var done = false;
              function loadOfferAnimation() {
                if (done) return;
                done = true;
                var img = document.querySelector(".black-friday-offer img[data-anim-src]");
                if (!img || img.closest(".black-friday-offer.over")) return;
                var anim = new Image();
                anim.onload = function () { img.src = anim.src; };
                anim.src = img.getAttribute("data-anim-src");
              }
              ["scroll", "pointerdown", "keydown", "touchstart"].forEach(function (eventName) {
                window.addEventListener(eventName, loadOfferAnimation, { once: true, passive: true });
              });
              window.addEventListener("load", function () { setTimeout(loadOfferAnimation, 4000); }, { once: true });
            })();
