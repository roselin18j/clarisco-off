                if (document.getElementById('pitchdesk-recaptcha-container')) {
                  window.pitchdeskWidgetId = grecaptcha.render('pitchdesk-recaptcha-container', {
                    sitekey: '6LdQzLEtAAAAAHr5lMRUCo8G_DriMlGGu4WZ0g99'
                  });
                }
                if (focused && focused !== document.body && document.activeElement !== focused) {
                  focused.focus({ preventScroll: true });
                }
              }
            }

            // reCAPTCHA tokens are single-use, so reset after every submit attempt.
            function resetRecaptcha(widgetId) {
              if (typeof grecaptcha !== "undefined" && widgetId !== undefined) {
                grecaptcha.reset(widgetId);
