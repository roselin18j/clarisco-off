            let recaptchaLoaded = false;

            function loadRecaptcha() {
              if (recaptchaLoaded) return;
              recaptchaLoaded = true;

              var script = document.createElement("script");
              script.src = "https://www.google.com/recaptcha/api.js?onload=renderRecaptcha&render=explicit";
              script.async = true;
              script.defer = true;

              document.body.appendChild(script);
            }


            function renderRecaptcha() {
              if (typeof grecaptcha !== "undefined") {
                // Rendering is triggered by the visitor's first keystroke; keep their
                // cursor in that field so the rest of what they type isn't lost.
                var focused = document.activeElement;
                // grecaptcha.render throws on a missing element, which would stop the
                // remaining widgets from rendering, so guard each container.
                if (document.getElementById('recaptcha-container')) {
                  window.footerWidgetId = grecaptcha.render('recaptcha-container', {
                    sitekey: '6LdQzLEtAAAAAHr5lMRUCo8G_DriMlGGu4WZ0g99'
                  });
                }
                if (document.getElementById('popup-recaptcha-container')) {
                  window.popupWidgetId = grecaptcha.render('popup-recaptcha-container', {
                    sitekey: '6LdQzLEtAAAAAHr5lMRUCo8G_DriMlGGu4WZ0g99'
                  });
                }
                if (document.getElementById('shortFormRecaptcha')) {
                  window.shortFormWidgetId = grecaptcha.render('shortFormRecaptcha', {
                    sitekey: '6LdQzLEtAAAAAHr5lMRUCo8G_DriMlGGu4WZ0g99',
                    callback: function (token) {
                      if (typeof recaptchaCompleted === 'function') recaptchaCompleted(token);
                    }
                  });
