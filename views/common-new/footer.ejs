<script>
document.addEventListener("DOMContentLoaded", function () {

    const floatingNav = document.querySelector(".floating-nav");
    const closeBtn = document.querySelector(".floating-nav-close");

    if (!floatingNav) return;

    let hideTimer;
    let manuallyClosed = false;

    function pastHero() {
        return window.scrollY >= window.innerHeight;
    }

    function showNav() {

        if (!pastHero() || manuallyClosed) return;

        floatingNav.classList.add("show");

        clearTimeout(hideTimer);

        // Automatically hide after 3 seconds
        hideTimer = setTimeout(() => {
            floatingNav.classList.remove("show");
        }, 3000);
    }

    function hideNav() {
        floatingNav.classList.remove("show");
        clearTimeout(hideTimer);
    }

    // Manual close
    if (closeBtn) {
        closeBtn.addEventListener("click", function (e) {
            e.preventDefault();
            e.stopPropagation();

            manuallyClosed = true;
            hideNav();
        });
    }

    // Initial state
    if (pastHero()) {
        showNav();
    }

    // Show again when user scrolls
    window.addEventListener("scroll", function () {

        if (pastHero()) {
            manuallyClosed = false;
            showNav();
        } else {
            hideNav();
        }

    });

    // Show on other user interactions
    ["mousemove", "click", "keydown", "touchstart", "wheel"].forEach(event => {

        document.addEventListener(event, function () {

            if (!manuallyClosed && pastHero()) {
                showNav();
            }

        });

    });

});
</script>
