  <!-- Perf (TBT): pages register many DOMContentLoaded listeners (one per slider
       / section). Browsers run them all inside ONE task, which on mobile became a
       ~500ms long task. Run each listener in its own task instead, in the same
       order. window 'load' listeners that fire while DOMContentLoaded work is
       still queued are queued behind it, so load code still runs after it.
       Perf (LCP): the footer's library scripts (bootstrap, swiper, validation...)
       are loaded via window.__claLoadScripts at DOMContentLoaded instead of as
       <script defer>, so they no longer compete with the hero image. Queued
       DOMContentLoaded / load work waits for them, exactly as it waited for the
       defer scripts before. -->
  <script>
    (function () {
      var queue = [], scheduled = false, loaded = false, gate = 0, root = document.documentElement;
      var docAdd = document.addEventListener, winAdd = window.addEventListener;
      // 'cla-preinit' lets CSS hide not-yet-initialised slider slides (no stacked
      // slides -> no layout shift). Removed once the page has loaded and all queued
      // init work ran, so a slider that never initialises looks as it did before.
      root.classList.add('cla-preinit');
      function busy() { return scheduled || gate > 0; }
      function maybeDone() { if (loaded && !queue.length && !gate) root.classList.remove('cla-preinit'); }
      window.addEventListener('load', function () { loaded = true; setTimeout(maybeDone, 0); });
      function pump() {
        if (gate > 0) { scheduled = false; return; }
        var job = queue.shift();
        if (job) { try { job(); } catch (e) { setTimeout(function () { throw e; }); } }
        if (queue.length) setTimeout(pump, 0); else { scheduled = false; maybeDone(); }
      }
      function kick() {
        if (!scheduled && !gate && queue.length) { scheduled = true; setTimeout(pump, 0); }
      }
      function enqueue(job) { queue.push(job); kick(); }
      // Load scripts in order (async=false keeps execution order), starting after
      // window load (see below). Each entry: a URL string or {src, integrity}.
      window.__claLoadScripts = function (list) {
        gate++;
        function start() {
          var left = list.length;
          function done() { if (--left <= 0) { gate--; kick(); maybeDone(); } }
          if (!left) return done();
          list.forEach(function (item) {
            var s = document.createElement('script');
            s.src = item.src || item;
            if (item.integrity) s.integrity = item.integrity;
            s.async = false;
            s.onload = s.onerror = done;
            document.body.appendChild(s);
          });
        }
        // Start after window 'load' (i.e. after the hero image has painted) so these
        // requests never compete with LCP, even when the HTML or hero arrives late.
        // Fallback: 2.5s after DOMContentLoaded in case 'load' is held up.
        var started = false;
        function startOnce() { if (!started) { started = true; start(); } }
        if (loaded || document.readyState === 'complete') startOnce();
        else {
          winAdd.call(window, 'load', function () { requestAnimationFrame(function () { setTimeout(startOnce, 0); }); });
          docAdd.call(document, 'DOMContentLoaded', function () { setTimeout(startOnce, 2500); });
        }
      };
      function patch(target, eventType, onlyWhenBusy) {
        var add = target.addEventListener, remove = target.removeEventListener, pairs = [];
        target.addEventListener = function (type, fn, opts) {
          if (type !== eventType || !fn) return add.apply(this, arguments);
          var self = this;
          var wrapped = function (ev) {
            var job = function () {
              if (typeof fn === 'function') fn.call(self, ev); else fn.handleEvent(ev);
            };
            if (onlyWhenBusy && !busy()) job(); else enqueue(job);
          };
          pairs.push([fn, wrapped]);
          return add.call(this, type, wrapped, opts);
        };
        target.removeEventListener = function (type, fn, opts) {
          if (type === eventType) {
            for (var i = 0; i < pairs.length; i++) if (pairs[i][0] === fn) { fn = pairs[i][1]; pairs.splice(i, 1); break; }
          }
          return remove.call(this, type, fn, opts);
        };
      }
      patch(document, 'DOMContentLoaded', false);
      patch(window, 'load', true);
    }());
  </script>

  <!-- Tag Manager loads after interaction/idle so it cannot compete with the critical rendering path. -->
  <script>
    (function () {
      var loaded = false;
      function loadTagManager() {
        if (loaded) return;
        loaded = true;
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
        var script = document.createElement('script');
        script.async = true;
        script.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-PSS37HK';
        document.head.appendChild(script);
      }
      ['scroll', 'pointerdown', 'keydown', 'touchstart'].forEach(function (eventName) {
        window.addEventListener(eventName, loadTagManager, { once: true, passive: true });
      });
      window.addEventListener('load', function () { setTimeout(loadTagManager, 4000); }, { once: true });
    }());
  </script>

