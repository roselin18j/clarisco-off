             opacity:0 until its JS runs, which delayed LCP by seconds. */
          .nwe-toke-sec-1 [data-aos], .nw-banner-sec-1 [data-aos], .nwe-toke-sec-2 [data-aos] {
            opacity: 1 !important; transform: none !important; transition: none !important;
          }
          /* Until Swiper initialises a slider, its slides stack vertically and then
             collapse (layout shift on the home hero). Show only the first slide
             until init. Swiper adds .swiper-initialized before it measures. */
          .cla-preinit .swiper:not(.swiper-initialized) > .swiper-wrapper > .swiper-slide ~ .swiper-slide {
            display: none;
          }
