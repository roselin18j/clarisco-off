<script>
    // The Services/Product panel (~2,600 elements) is fetched on demand from
    // /partials/mobile-menu instead of being in every page's HTML. Fetching starts
    // on the visitor's first touch/click anywhere, so it is normally ready by the
    // time they tap Services or Product. All handlers below are delegated so they
    // work for the inserted content.
    var mobileMenuPromise = null;
    function loadMobileMenu() {
        if (mobileMenuPromise) return mobileMenuPromise;
        var holder = document.getElementById("id-menu-section");
        if (!holder || !holder.getAttribute("data-partial")) {
            mobileMenuPromise = Promise.resolve();
            return mobileMenuPromise;
        }
        mobileMenuPromise = fetch(holder.getAttribute("data-partial"), { credentials: "same-origin" })
            .then(function (r) { if (!r.ok) throw new Error("mobile menu " + r.status); return r.text(); })
            .then(function (html) {
                holder.innerHTML = html;
                holder.removeAttribute("data-partial");
            })
            .catch(function (err) {
                mobileMenuPromise = null; // allow a retry on the next tap
                console.warn(err);
            });
        return mobileMenuPromise;
    }
    ["pointerdown", "touchstart", "keydown"].forEach(function (eventName) {
        window.addEventListener(eventName, loadMobileMenu, { once: true, passive: true });
    });

    $(document).ready(function () {

        function updateBodyClass() {
            if ($('.service-content').is(':visible') || $('.product-content').is(':visible')) {
                $('body').addClass('over-hid');
            } else {
                $('body').removeClass('over-hid');
            }
        }

        $(document).on("click", ".service-link", function () {
            loadMobileMenu().then(function () {
                $('.service-content').toggle();
                $('.product-content').hide();
                updateBodyClass();
            });
        });

        $(document).on("click", ".product-link", function () {
            loadMobileMenu().then(function () {
                $('.product-content').toggle();
                $('.service-content').hide();
                updateBodyClass();
            });
        });

        $(document).on("click", ".whole-close-service", function () {
            $('.service-content').hide();
            updateBodyClass();
        });

        $(document).on("click", ".whole-close-product", function () {
            $('.product-content').hide();
            updateBodyClass();
        });

        // Close when clicking outside
        $(document).click(function (event) {
            var target = $(event.target);

            if (!target.closest('.service-content, .service-link').length) {
                $('.service-content').hide();
            }

            if (!target.closest('.product-content, .product-link').length) {
                $('.product-content').hide();
            }

            updateBodyClass();
        });

    });
</script>

<script>
    let buttonStack = [];

    $(document).ready(function () {
        $(document).on("click", ".btn-w", function () {
            $(".button-content").addClass("d-none");
            $(".btn-w").addClass("d-none");
            $(".back-btn").removeClass("d-none");
            const buttonId = $(this).attr("id");
            const contentId = `${buttonId}-content`;
            const contentToShow = $(`#${contentId}`);
            if (contentToShow.length > 0) {
                contentToShow.removeClass("d-none");
                buttonStack.push(buttonId);
            }
        });

        $(document).on("click", ".btn-w-1", function () {
            $(".btn-w-1").addClass("d-none");
            const buttonId = $(this).attr("id");
            const contentId = `${buttonId}-content`;
            const contentToShow = $(`#${contentId}`);
            if (contentToShow.length > 0) {
                contentToShow.removeClass("d-none");
                buttonStack.push(buttonId);
            }
        });

        $(document).on("click", ".back-btn", function () {
            if (buttonStack.length > 0) {
                const lastButtonId = buttonStack.pop();
                const lastContentId = `${lastButtonId}-content`;
                $(`#${lastContentId}`).addClass("d-none");

                // Show the previous content and buttons
                if (buttonStack.length > 0) {
                    const prevButtonId = buttonStack[buttonStack.length - 1];
                    const prevContentId = `${prevButtonId}-content`;
                    $(`#${prevContentId}`).removeClass("d-none");

                    // Show buttons based on their levels
                    if (prevButtonId.includes('-')) {
                        $(".btn-w-1").removeClass("d-none");
                    } else {
                        $(".btn-w").removeClass("d-none");
                    }
                } else {
                    $(".btn-w").removeClass("d-none");
                    $(".back-btn").addClass("d-none");
                }
            }
        });
    });
</script>


