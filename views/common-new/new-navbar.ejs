<script>
    document.addEventListener("DOMContentLoaded", () => {
        const items = document.querySelectorAll(".menu-links > ul > li");
        const OPEN_DELAY = 60, CLOSE_DELAY = 280, SWITCH_DELAY = 60;
        let openTimer, closeTimer;

        // add "over-hid" to body while any menu is open, remove it when all are closed
        const syncBody = () => {
            const anyOpen = [...items].some(li => li.classList.contains("is-open"));
            document.body.classList.toggle("over-hid", anyOpen);
        };

        const closeAll = () => {
            items.forEach(li => li.classList.remove("is-open"));
            syncBody();
        };

        items.forEach(li => {
            const menu = li.querySelector(":scope > .float-menu");
            if (!menu) return;
            const link = li.querySelector(":scope > a");

            const sideItems = [...menu.querySelectorAll(".sub-menu-hd li[data-panel]")]
                .filter(s => menu.querySelector(`.sub-menu-links[data-panel="${s.dataset.panel}"]`));
            const tabbed = sideItems.length > 0;
            if (tabbed) menu.classList.add("has-tabs");

            const activate = key => {
                sideItems.forEach(s => s.classList.toggle("is-active", s.dataset.panel === key));
                menu.querySelectorAll(".sub-menu-links[data-panel]").forEach(p =>
                    p.classList.toggle("is-active", p.dataset.panel === key));
            };

            const open = () => {
                closeAll();
                li.classList.add("is-open");
                syncBody();
                if (tabbed) activate(sideItems[0].dataset.panel);
            };

            const close = () => {
                li.classList.remove("is-open");
                syncBody();
            };

            // top menu hover
            li.addEventListener("mouseenter", () => {
                clearTimeout(closeTimer); clearTimeout(openTimer);
                openTimer = setTimeout(open, OPEN_DELAY);
            });
            li.addEventListener("mouseleave", () => {
                clearTimeout(openTimer);
                closeTimer = setTimeout(close, CLOSE_DELAY);
            });

            // keyboard
            li.addEventListener("focusin", () => { if (!li.classList.contains("is-open")) open(); });
            li.addEventListener("focusout", e => {
                if (!li.contains(e.relatedTarget)) close();
            });

            // touch: first tap opens, second follows link
            link.addEventListener("click", e => {
                if (window.matchMedia("(hover: none)").matches && !li.classList.contains("is-open")) {
                    e.preventDefault(); open();
                }
            });

            // sidebar hover -> show that panel on the right
            if (!tabbed) return;
            let switchTimer;
            sideItems.forEach(side => {
                const show = () => activate(side.dataset.panel);
                side.addEventListener("mouseenter", () => {
                    clearTimeout(switchTimer);
                    switchTimer = setTimeout(show, SWITCH_DELAY);
                });
                side.addEventListener("mouseleave", () => clearTimeout(switchTimer));
                side.addEventListener("focusin", show);
                side.addEventListener("click", e => {
                    const a = side.querySelector("a");
                    if (!a || a.getAttribute("href") === "#") e.preventDefault();
                    show();
                });
            });
        });

        document.addEventListener("click", e => { if (!e.target.closest(".menu-links")) closeAll(); });
        document.addEventListener("keydown", e => { if (e.key === "Escape") closeAll(); });
    });
</script>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const openBtn = document.getElementById("openSidebar");
        const mobNav = document.getElementById("mob-sub");
        if (!openBtn || !mobNav) return;

        const openMob = () => {
            mobNav.classList.add("is-open");
            document.body.classList.add("over-hid");
        };

        const closeMob = () => {
            mobNav.classList.remove("is-open");
            document.body.classList.remove("over-hid");
        };

        // open
        openBtn.addEventListener("click", e => {
            e.stopPropagation();
            mobNav.classList.contains("is-open") ? closeMob() : openMob();
        });

        // close button (X)
        mobNav.querySelector(".close")?.addEventListener("click", closeMob);

        // click outside the menu
        document.addEventListener("click", e => {
            if (!mobNav.classList.contains("is-open")) return;
            if (e.target.closest("#mob-sub") || e.target.closest("#openSidebar")) return;
            closeMob();
        });

        // Esc key
        document.addEventListener("keydown", e => {
            if (e.key === "Escape") closeMob();
        });

        // close after tapping a link inside the menu
        mobNav.querySelectorAll("a").forEach(a => a.addEventListener("click", closeMob));

        // if the screen grows to desktop size, reset
        window.matchMedia("(min-width: 992px)").addEventListener("change", e => {
            if (e.matches) closeMob();
        });
    });
</script>

<script>
(function () {
    function init() {
        const mobNav = document.getElementById("mob-sub");
        if (!mobNav) { console.warn("mob-sub not found"); return; }
        const sections = [...mobNav.querySelectorAll(".mobSubMnu")];
        console.log("accordion ready, sections:", sections.length);

        const open = sec => {
            const body = sec.querySelector(":scope > .mob-body");
            if (!body) return;
            sec.classList.add("is-open");
            body.style.height = body.scrollHeight + "px";
            setTimeout(() => {
                if (sec.classList.contains("is-open")) body.style.height = "auto";
            }, 360);
        };

        const close = sec => {
            const body = sec.querySelector(":scope > .mob-body");
            if (!body || !sec.classList.contains("is-open")) return;
            body.style.height = body.scrollHeight + "px";
            void body.offsetHeight;
            body.style.height = "0px";
            sec.classList.remove("is-open");
        };

        mobNav.addEventListener("click", e => {
            const title = e.target.closest(".mobSubMnu > p");
            if (!title) return;
            console.log("clicked:", title.textContent.trim());
            const sec = title.parentElement;
            const wasOpen = sec.classList.contains("is-open");
            sections.forEach(s => { if (s !== sec) close(s); });
            wasOpen ? close(sec) : open(sec);
        });

        new MutationObserver(() => {
            if (!mobNav.classList.contains("is-open")) sections.forEach(close);
        }).observe(mobNav, { attributes: true, attributeFilter: ["class"] });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
    } else {
        init();
    }
})();
</script>