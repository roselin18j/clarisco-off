                                alt="Pawqeris Pet Care Platform Overview" class="img-fluid pawqeris-overview-image">
                        </div>
                    </div>

                </div>
            </section>

            <% const challengeData=[ { title: "Advice without action" ,
                description: "Most assistants suggest next steps but leave the ordering, paying, and booking to the user."
                }, { title: "A trust gap" ,
                description: "Wrong orders, hidden charges, and unclear responsibility make people cautious." }, {
                title: "No reliable proof" ,
                description: "Chat logs can be edited or lost, so disputes are hard to settle." }, {
                title: "Scattered tools" ,
                description: "Research, shopping, food, travel, email, and news sit in separate apps." }, {
                title: "Limited control" ,
                description: "Users want to decide how much freedom the agent gets, and most products offer little say."
                } ]; %>

                <section class="pawqeris-challenge py-5">
                    <div class="container">

                        <div class="text-center mb-4">
                            <h2 class="pawqeris-challenge-title">The Challenge</h2>
                            <p class="pawqeris-challenge-description">
                                AI assistants converse well, yet people hesitate to hand over real tasks. Our research
                                with consumers and merchants revealed five barriers.
                            </p>
                        </div>

                        <% challengeData.forEach((item)=> { %>
                            <div class="pawqeris-challenge-item d-flex align-items-stretch mb-3">

                                <div
                                    class="pawqeris-challenge-label d-flex align-items-center justify-content-center text-center">
                                    <%= item.title %>
                                </div>

                                <div class="pawqeris-challenge-content d-flex align-items-center">
                                    <%= item.description %>
                                </div>

                            </div>
                            <% }) %>

                    </div>
                </section>



                <% const objectivesData=[ "Build an agent that completes everyday tasks."
                    , "Give users firm control over permissions and spending."
                    , "Record every action so it can be verified later."
                    , "Bring information, commerce, planning, and news into one place."
                    , "Keep the experience simple for people who know nothing about blockchain." ]; const solutionData={
                    title: "Our Solution" ,
                    description: "Our guiding idea was autonomy with accountability. The agent moves quickly on the user's behalf, but only within limits they set, and always leaves a trail that can be checked."
                    }; %>


                    <section class="pawqeris-objectives py-4 py-lg-5">
                        <div class="container">

                            <div class="row pawqeris-obj-row align-items-start position-relative g-0">

                                <!-- Curve divider -->
                                <div class="pawqeris-objectives-curve d-none d-md-block">
                                    <img src="https://assets.clarisco.com/assets/case-study/curve.webp" alt="" class="img-fluid">
                                </div>

                                <!-- Objectives -->
                                <div class="col-md-6 pawqeris-objectives-content pawqeris-objectives-left">


                                    <h2 class="case-htags pawqeris-objectives-title mb-2">
                                        Objectives
                                    </h2>

                                    <div class="pawqeris-objectives-line mb-3"></div>

                                    <p class="pawqeris-objectives-intro mb-3 mb-md-4 mb-lg-4">
                                        These objectives balance what people want most from an AI agent: action and
                                        control. Each one guided how we designed Novaryx's permissions and records.
                                    </p>

                                    <ol class="pawqeris-objectives-list list-unstyled mb-0">
                                        <% objectivesData.forEach((objective, index)=> { %>
                                            <li class="d-flex align-items-start mb-2 mb-lg-3 mb-md-3">
                                                <span class="pawqeris-objective-number me-3">
                                                    <%= String(index + 1).padStart(2, '0' ) %>.
                                                </span>

                                                <span class="pawqeris-objective-text">
                                                    <%= objective %>
                                                </span>
                                            </li>
                                            <% }) %>
                                    </ol>

                                </div>


                                <!-- Our Solution -->
                                <div class="col-md-6 pawqeris-objectives-content pawqeris-objectives-right">


