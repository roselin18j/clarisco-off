                    </div>
                </div>
            </section>


            <section class="pawqeris-overview py-3 py-lg-5 py-md-4">
                <div class="container">

                    <div class="row justify-content-center text-center">
                        <div class="col-lg-10">



                            <h2 class="case-htags mb-3">
                                Overview
                            </h2>

                            <p class="pawqeris-overview-text col-lg-8 mx-auto">
                                Pawqeris is a pet-care platform that puts a pet's whole life story in one trusted place.
                                Owners and professionals can record, view, share, and pass on everything from birth
                                details and vaccinations to DNA results and ownership history.
                            </p>

                            <p class="pawqeris-overview-text">
                                Every pet receives its own Decentralized ID (DID). This one identity ties the app
                                together, so health records, bookings, wearable readings, payments, and community
                                activity all attach to the same verified profile, with the owner in charge.
                            </p>

                            <p class="pawqeris-overview-text mb-4">
                                Clarisco Solutions handled the project from the initial discussion to launch.
                            </p>

                        </div>
                    </div>

                    <div class="row justify-content-center">
                        <div class="col-lg-7 col-md-9 col-11 text-center">
                            <img src="https://assets.clarisco.com/assets/case-study/paw-3.webp"
                                alt="Pawqeris Pet Care Platform Overview" class="img-fluid pawqeris-overview-image">
                        </div>
                    </div>

                </div>
            </section>

            <% const challengeData=[ { title: "Records everywhere" ,
                description: "Vaccination cards, certificates, and pedigree papers live in drawers, clinic software, and old chats."
                }, { title: "Doubtful authenticity" ,
                description: "Documents can be edited or forged, which creates friction in adoption, breeding, travel, and resale."
                }, { title: "No clear handover" ,
                description: "Moving a pet to a new owner lacks a standard, provable process." }, {
                title: "Fragmented services" ,
                description: "Booking care, buying products, monitoring health, and learning all happen in different places."
                }, { title: "Few ways to give back" ,
                description: "People who want to back shelters, research, or events lack transparent options." } ]; %>

                <section class="pawqeris-challenge py-5">
                    <div class="container">

                        <div class="text-center mb-4">
                            <h2 class="case-htags mb-3">The Challenge</h2>
                            <p class="pawqeris-challenge-description">
                                Pet data is scattered and easy to lose or dispute.
                                Our discovery sessions with owners, vets, and shelters
                                surfaced five core problems:
                            </p>
                        </div>

                        <% challengeData.forEach((item)=> { %>
                            <div
                                class="pawqeris-challenge-item d-flex align-items-stretch mb-2 mb-lg-3 col-lg-11 mx-auto">

                                <b
                                    class="pawqeris-challenge-label d-flex align-items-center justify-content-center text-center">
                                    <%= item.title %>
                                </b>

                                <p class="pawqeris-challenge-content d-flex align-items-center">
                                    <%= item.description %>
                                </p>

                            </div>
                            <% }) %>

                    </div>
                </section>


                <% const objectivesData=[ "Issue each pet a tamper-proof identity controlled by its owner."
                    , "Let records be shared and transferred easily and safely."
                    , "Combine care, shopping, community, and charity in one experience."
                    , "Use AI and wearables to catch health issues early."
                    , "Keep the platform secure and easy for non-technical users." ]; const solutionData={
                    title: "Our Solution" ,
                    description: "Our design principle was simple: the pet's identity comes first, and every feature draws from it. Whether an entry comes from a vet, a breeder, or a smart collar, it lands on the same trusted profile."
                    }; %>



                    <section class="pawqeris-objectives py-4 py-lg-5">
                        <div class="container">

                            <div class="row pawqeris-obj-row align-items-start position-relative g-0">

                                <!-- Curve divider -->
                                <div class="pawqeris-objectives-curve d-none d-md-block">
                                    <img src="https://assets.clarisco.com/assets/case-study/curve.webp" alt="" class="img-fluid">
                                </div>

                                <!-- Objectives -->
                                <div class="col-md-6 pawqeris-objectives-content pawqeris-objectives-left">


                                        <h2 class="case-htags pawqeris-objectives-title mb-2">
                                            Objectives
                                        </h2>

                                        <div class="pawqeris-objectives-line mb-3"></div>

                                        <p class="pawqeris-objectives-intro mb-3 mb-md-4 mb-lg-4">
                                            To achieve our goals, we focus on creating a seamless
                                            and meaningful experience that drives real value.
                                        </p>

                                        <ol class="pawqeris-objectives-list list-unstyled mb-0">
                                            <% objectivesData.forEach((objective, index)=> { %>
                                                <li class="d-flex align-items-start mb-2 mb-lg-3 mb-md-3">
                                                    <span class="pawqeris-objective-number me-3">
                                                        <%= String(index + 1).padStart(2, '0' ) %>.
                                                    </span>

                                                    <span class="pawqeris-objective-text">
                                                        <%= objective %>
                                                    </span>
                                                </li>
                                                <% }) %>
                                        </ol>

                                    </div>


                                <!-- Our Solution -->
                                <div class="col-md-6 pawqeris-objectives-content pawqeris-objectives-right">


                                        <h2 class="case-htags pawqeris-objectives-title mb-2">
                                            <%= solutionData.title %>
                                        </h2>

                                        <div class="pawqeris-objectives-line mb-3"></div>

                                        <p class="pawqeris-solution-description mb-4">
                                            <%= solutionData.description %>
                                        </p>

                                        <div class="pawqeris-solution-highlight text-center">
                                            "Every pet deserves an identity that can't be lost or altered. We built
                                            Pawqeris so one trusted profile follows a pet through every vet visit,
                                            adoption, and new home."
                                        </div>

                                    </div>

                            </div>
                        </div>
                    </section>


                    <% const primaryFeaturesData=[ { title: "Pet NFTs" ,
                        description: "A unique token representing the pet and pointing to its verified records." }, {
                        title: "Pet Identification" ,
                        description: "Name, photos, microchip and tag numbers, and identifying marks, tied to the DID."
                        }, { title: "Birth Records" ,
                        description: "Birth date, location, litter, and breeder information." }, {
                        title: "Ancestry and DNA Data" ,
                        description: "Breed mix, lineage, and genetic findings, visible only with the owner's approval."
                        }, { title: "Vaccination Records" ,
                        description: "Vet-confirmed shots with automatic reminders for upcoming doses." }, {
                        title: "Health Certificates" ,
                        description: "Digitally issued, checkable certificates for travel, boarding, breeding, and adoption."
                        }, { title: "Ownership History" ,
                        description: "A dated chain of owners, with secure, auditable transfers." } ]; %>

                        <section class="pawqeris-primary-features  py-5">
                            <div class="container">

                                <div class="text-center mb-4">
                                    <h2 class="case-htags mb-2">
                                        Primary Features
                                    </h2>

                                    <p class="pawqeris-features-description mb-2">
                                        Trusted, Tamper-Resistant Pet Records
                                    </p>

                                    <p class="pawqeris-features-description mb-0">
                                        Core data is anchored on the blockchain, so anyone can verify an entry,
                                        but no one can quietly change it. The record vault holds:
                                    </p>
                                </div>

                                <div class="mt-2 col-lg-11 mx-auto row justify-content-center align-items-start g-4">

                                    <div class="col-lg-5 col-md-5">
                                        <img src="https://assets.clarisco.com/assets/case-study/paw-4.webp"
                                            alt="Pawqeris Primary Features" class="img-fluid pawqeris-features-image">
                                    </div>

                                    <div class="col-lg-7 col-md-7">
                                        <ul class="pawqeris-features-list mb-0">
                                            <% primaryFeaturesData.forEach((item)=> { %>
                                                <li class="pawqeris-feature-item">
                                                    <h6>
                                                        <%= item.title %>
                                                    </h6>
                                                    <p>
                                                        <%= item.description %>
                                                    </p>
                                                </li>
                                                <% }) %>
                                        </ul>
                                    </div>

                                </div>

                            </div>
                        </section>


                        <% const bookingData={ title: "Quick Vet and Grooming Bookings" ,
