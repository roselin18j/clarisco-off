                                <p>Pawqeris</p>
                            </div>

                            <div class="pawqeris-info-item pawqeris-left-item paw-two">
                                <h6>Industry</h6>
                                <p>Pet Care, Web3, Digital Identity</p>
                            </div>

                            <div class="pawqeris-info-item pawqeris-left-item">
                                <h6>Platform</h6>
                                <p>iOS and Android apps, plus a web dashboard for professionals</p>
                            </div>
                        </div>

                        <div class="text-center cenImg-item p-0">
                            <img src="https://assets.clarisco.com/assets/case-study/paw-2.webp" alt="Pawqeris Project Snapshot"
                                class="img-fluid">

                        </div>

                        <div class="rytProj-item cont-itm p-0">
                            <div class="pawqeris-info-item pawqeris-right-item">
                                <h6>Users</h6>
                                <p>Pet owners, vets, groomers, breeders, shelters, vendors</p>
