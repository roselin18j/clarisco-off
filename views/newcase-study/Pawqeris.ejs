                            description: "A lively community for sharing stories, photos, and tips, with groups organised by breed or area."
                            }, { title: "Knowledge Corner" ,
                            description: "Articles, guides and videos on training, nutrition, behaviour and health, written or reviewed by verified professionals."
                            }, { title: "Marketplace" ,
                            description: "A storefront that introduces owners to trusted vendors, with suggestions matched to the pet's breed, age and health."
                            }, { title: "Smart Wearable Sync" ,
                            description: "Collars and trackers feed activity, sleep, heart rate, and location into the profile, and the app alerts owners when readings look unusual."
                            }, { title: "Pawqeris AI Guide" ,
                            description: "A chat assistant that answers care questions, explains health trends, spots early warning signs, and points owners to nearby professionals when needed."
                            }, { title: "Rainbow Bridge Memorial" ,
                            description: "A calm, respectful corner for remembering pets who have passed, with galleries and tributes."
                            }, { title: "Pet Future Fund" ,
                            description: "Planning tools for setting money aside for medical care, insurance, and long-term needs."
                            }, { title: "Virtual Adoption" ,
                            description: "Users sponsor, name, and follow a pet remotely and receive regular updates, with no need to take the animal home. It suits people who cannot keep a pet."
                            }, { title: "Shelter Giving" ,
                            description: "Tokens can be donated to verified shelters and charities, with clear updates on how the money was used."
                            }, { title: "Pet Health Crowdfunding" ,
                            description: "Community campaigns where users pool tokens for pet health research and animal welfare work, with progress visible to all."
                            }, { title: "Events and Sponsorships" ,
                            description: "Entry to online and on-site pet events such as adoption drives, expos, and wellness camps, plus sponsorship options for brands."
                            } ]; %>

                            <section class="pawqeris-booking-features col-lg-9 mx-auto  py-3 py-lg-5 py-md-4">
                                <div class="container">

                                    <div class="row col-lg-10 justify-content-start mb-4">
                                        <div class="w-100">
                                            <h2 class="pawqeris-booking-title mb-2">
                                                <%= bookingData.title %>
                                            </h2>

                                            <p class="pawqeris-booking-description mb-0">
                                                <%= bookingData.description %>
                                            </p>
                                        </div>
                                    </div>

                                    <div class="row justify-content-center">
                                        <div class="w-100">

                                            <h3 class="pawqeris-secondary-title mb-3">
                                                Secondary Features
                                            </h3>

                                            <div class="pawqeris-secondary-card">
                                                <% secondaryFeaturesData.forEach((item)=> { %>
                                                    <div class="pawqeris-secondary-item d-flex align-items-start">
                                                        <div class="pawqeris-secondary-label">
                                                            <h6 class="mb-2">
                                                                <%= item.title %>
                                                            </h6>
                                                        </div>
                                                        <div class="pawqeris-secondary-content">
                                                            <p class="mb-0">
                                                                <%= item.description %>
                                                            </p>
                                                        </div>
                                                    </div>
                                                    <% }) %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </section>

                            <section class="pawqeris-additonal py-5">
                                <div class="container">

                                    <div class="row col-lg-7 mx-auto mb-lg-4 mb-md-3 mb-2">
                                        <div class="col-12 text-center">
                                            <h2 class="case-htags">Additional Features Added by Clarisco</h2>
                                        </div>
                                    </div>

                                    <div class="row g-5 additonal-rows justify-content-center mt-lg-4 mt-md-3 mt-2">

                                        <!-- Left Column -->
                                        <div class="col-lg-6 mt-lg-4 mt-md-3 mt-2">

                                            <div class="mb-3 mb-md-4 mb-lg-5 ">
                                                <h6 class="fw-bold">Lost Pet Alerts and Recovery:</h6>
                                                <p class="mb-0">
                                                    A one-tap report notifies nearby users, shelters, and vets. QR and
                                                    NFC tags open a safe public profile that keeps owner details
                                                    private.
                                                </p>
                                            </div>

                                            <div class="mb-3 mb-md-4 mb-lg-5">
                                                <h6 class="fw-bold">Smart Health Reminders:</h6>
                                                <p class="mb-0">
                                                    Alerts for vaccines, deworming, medication, check-ups, and grooming.
                                                </p>
                                            </div>

                                            <div class="mb-3 mb-md-4 mb-lg-5">
                                                <h6 class="fw-bold">Multi-Pet and Family Access:</h6>
                                                <p class="mb-0">
                                                    Several pets per account, with permission levels for family,
                                                    sitters, and walkers.
                                                </p>
                                            </div>

                                            <div class="mb-3 mb-md-4 mb-lg-5">
                                                <h6 class="fw-bold">Consent-Based Data Sharing:</h6>
                                                <p class="mb-0">
                                                    Owners decide what to share, with whom, and for how long, and can
                                                    withdraw access anytime.
                                                </p>
                                            </div>

                                            <div class="mb-3 mb-md-4 mb-lg-5">
                                                <h6 class="fw-bold">Pet Insurance Integration:</h6>
                                                <p class="mb-0">
                                                    Compare plans, buy cover, and file claims backed by verified
                                                    records.
                                                </p>
                                            </div>

                                            <div class="mb-0">
                                                <h6 class="fw-bold">Breeder and Shelter Verification:</h6>
                                                <p class="mb-0">
                                                    Credential checks and badges that build trust and deter fraud.
                                                </p>
                                            </div>

                                        </div>

                                        <!-- Right Column -->
                                        <div class="col-lg-6 mt-md-4 mt-lg-4 mt-md-3 mt-2">

                                            <div class="mb-3 mb-md-4 mb-lg-5">
                                                <h6 class="fw-bold">Travel Document Wizard:</h6>
                                                <p class="mb-0">
                                                    Step-by-step checklists and exportable certificates for local and
                                                    international trips.
                                                </p>
                                            </div>

                                            <div class="mb-3 mb-md-4 mb-lg-5">
                                                <h6 class="fw-bold">Nutrition and Weight Tracking:</h6>
                                                <p class="mb-0">
                                                    Tailored diet plans, feeding logs, and growth charts.
                                                </p>
                                            </div>

                                            <div class="mb-3 mb-md-4 mb-lg-5">
                                                <h6 class="fw-bold">Pet Services Directory:</h6>
                                                <p class="mb-0">
                                                    Trainers, walkers, boarders and sitters with verified reviews.
                                                </p>
                                            </div>

                                            <div class="mb-3 mb-md-4 mb-lg-5">
                                                <h6 class="fw-bold">Rewards and Gamification:</h6>
                                                <p class="mb-0">
                                                    Tokens and badges for healthy habits, community activity, and
                                                    giving.
                                                </p>
                                            </div>

                                            <div class="mb-3 mb-md-4 mb-lg-5">
                                                <h6 class="fw-bold">Multilingual Support and Accessibility:</h6>
                                                <p class="mb-0">
                                                    Regional languages and accessible design.
                                                </p>
                                            </div>

                                            <div class="mb-0">
                                                <h6 class="fw-bold">Admin and Analytics Console:</h6>
                                                <p class="mb-0">
                                                    Moderation, onboarding, shelter verification, campaign approvals,
                                                    and insights for the platform team.
                                                </p>
                                            </div>

                                        </div>

                                    </div>

                                </div>
