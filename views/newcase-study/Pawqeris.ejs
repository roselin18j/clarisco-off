                            <% const technologyApproachData=[ { layer: "Identity" ,
                                approach: "A DID per pet, with verifiable credentials issued by authorities" }, {
                                layer: "Blockchain" , approach: "Record anchoring, NFT minting, and token donations" },
                                { layer: "Mobile and Web" , approach: "Cross-platform apps and a professional dashboard"
                                }, { layer: "Backend" , approach: "Cloud services, secure APIs, and role-based access"
                                }, { layer: "AI" ,
                                approach: "Conversational guide with health-trend analysis and referral logic" }, {
                                layer: "IoT" ,
                                approach: "Wearable and smart collar integrations for continuous health data" }, {
                                layer: "Security" ,
                                approach: "End-to-end encryption, multi-factor login, and audit trails" } ]; %>


                                <section class="pawqeris-technology py-3 py-lg-5 py-md-4">
                                    <div class="container">

                                        <h2 class="case-htags text-center mb-3 mb-lg-4 mb-md-4">
                                            Our Technology Approach
                                        </h2>

                                        <div class="row justify-content-center">
