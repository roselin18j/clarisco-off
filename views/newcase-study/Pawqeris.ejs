                                                                <div class="col-3">
                                                                    <div class="pawqeris-technology-layer">
                                                                        <p>
                                                                            <%= item.layer %>
                                                                        </p>
                                                                    </div>
                                                                </div>

                                                                <div class="col-9">
                                                                    <div class="pawqeris-technology-approach">
                                                                        <p>
                                                                            <%= item.approach %>
                                                                        </p>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <% }) %>

                                                    </div>
                                                </div>

                                            </div>
                                        </div>

                                    </div>
                                </section>

