                                                    <div class="pawqeris-technology-table">

                                                        <div class="row g-0 pawqeris-technology-header">
                                                            <div class="col-3 text-center">Layer</div>
                                                            <div class="col-9 text-center">Approach</div>
                                                        </div>

                                                        <% technologyApproachData.forEach((item)=> { %>
