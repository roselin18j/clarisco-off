                                                                        <p>
                                                                            <%= item.approach %>
                                                                        </p>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <% }) %>

                                                    </div>
                                                </div>

                                            </div>
                                        </div>

                                    </div>
