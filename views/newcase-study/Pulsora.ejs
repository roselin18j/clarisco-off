                    <div class="row align-items-center justify-content-center">

                        <div class="lftProj-item cont-itm p-0">
                            <div class="pawqeris-info-item pawqeris-left-item">
                                <h6>Project</h6>
                                <p>Pulsora</p>
                            </div>

                            <div class="pawqeris-info-item pawqeris-left-item paw-two">
                                <h6>Industry</h6>
                                <p>Fitness, Sports Tech, Wellness, Rewards</p>
                            </div>

                            <div class="pawqeris-info-item pawqeris-left-item">
                                <h6>Platform</h6>
                                <p>iOS and Android apps, plus a web command center for professionals</p>
                            </div>
                        </div>

                        <div class="text-center cenImg-item p-0">
                            <img src="https://assets.clarisco.com/assets/case-study/pul-2.webp" alt="Pawqeris Project Snapshot"
                                class="img-fluid">

                        </div>

                        <div class="rytProj-item cont-itm p-0">
                            <div class="pawqeris-info-item pawqeris-right-item">
                                <h6>Users</h6>
                                <p>Athletes, fitness enthusiasts, coaches, clubs, dietitians, doctors</p>
                            </div>

                            <div class="pawqeris-info-item pawqeris-right-item paw-two">
                                <h6>Core Technology</h6>
                                <p>Activity Tracking, Wearable Integration, AI Coaching, Rewards</p>
                            </div>

                            <div class="pawqeris-info-item pawqeris-right-item">
                                <h6>Delivered by</h6>
                                <p>Clarisco Solutions</p>
                            </div>
                        </div>

                    </div>
                </div>
            </section>


            <section class="pawqeris-overview py-3 py-lg-5 py-md-4">
                <div class="container">

                    <div class="row justify-content-center text-center">
                        <div class="col-lg-10">



                            <h2 class="case-htags mb-3">
                                Overview
                            </h2>

                            <p class="pawqeris-overview-text col-lg-8 mx-auto">
                                Pulsora is a fitness platform that pays people back for moving. Every run, ride, gym
                                session, or training class earns points, and those points build into a personal score
                                that reflects body, mind, spirit, and community.
                            </p>

                            <p class="pawqeris-overview-text">
                                The platform has two sides. Athletes get a daily app with an AI trainer, a live map of
                                nearby training partners and a reward wallet. Coaches, clubs, dietitians and doctors get
                                a command center to manage clients, bookings, payments and plans.
                            </p>

                            <p class="pawqeris-overview-text mb-4">
                                Clarisco Solutions delivered the project from concept to launch, covering strategy, UX,
                                mobile and web development, AI coaching, rewards logic, integrations and testing.
                            </p>

                        </div>
                    </div>

                    <div class="row justify-content-center">
                        <div class="col-lg-7 col-md-9 col-11 text-center">
                            <img src="https://assets.clarisco.com/assets/case-study/pul-3.webp"
                                alt="Pawqeris Pet Care Platform Overview" class="img-fluid pawqeris-overview-image">
                        </div>
                    </div>

                </div>
            </section>

            <% const challengeData=[ { title: "Weak motivation" ,
                description: "Progress is slow to see, and there is little reward for showing up consistently." }, {
                title: "Isolation" , description: "Training alone is hard, and finding partners nearby is awkward." }, {
                title: "Generic plans" ,
                description: "Workout advice ignores sleep, recovery, and how the person feels that day." }, {
                title: "Fragmented tools" ,
                description: "Tracking, coaching, nutrition, and payments live in separate apps." }, {
                title: "Heavy admin for professionals " ,
                description: "Coaches lose time on scheduling, invoicing, and client follow-up." }, {
                title: "Easy to cheat" , description: "Reward apps often fail when users fake activity." } ]; %>

                <section class="pawqeris-challenge py-5">
                    <div class="container">

                        <div class="text-center mb-4">
                            <h2 class="case-htags mb-3">The Challenge</h2>
                            <p class="pawqeris-challenge-description">
                                Most people start fitness routines with energy and drop them within weeks. Our research
                                with athletes, coaches and clubs showed why.
                            </p>
                        </div>

                        <% challengeData.forEach((item)=> { %>
                            <div
                                class="pawqeris-challenge-item d-flex align-items-stretch mb-2 mb-lg-3 col-lg-11 mx-auto">

                                <b
                                    class="pawqeris-challenge-label d-flex align-items-center justify-content-center text-center">
                                    <%= item.title %>
                                </b>

                                <p class="pawqeris-challenge-content d-flex align-items-center">
                                    <%= item.description %>
                                </p>

                            </div>
                            <% }) %>

                    </div>
                </section>


                <% const objectivesData=[ "Reward real, verified activity across many sports."
                    , "Build daily habits through scores, streaks, and community."
                    , "Personalise training using sleep, recovery and performance data."
                    , "Give coaches and clinicians one place to run their practice."
                    , "Keep rewards fair by detecting fake or manipulated workouts." ]; const solutionData={
                    title: "Our Solution" ,
                    description: "Our guiding idea was that effort should count. Pulsora measures what a person actually does, converts it into points and a clear score, and uses that momentum to bring training, coaching, and community together."
                    }; %>



                    <section class="pawqeris-objectives py-4 py-lg-5">
                        <div class="container">

                            <div class="row pawqeris-obj-row align-items-start position-relative g-0">

                                <!-- Curve divider -->
                                <div class="pawqeris-objectives-curve d-none d-md-block">
                                    <img src="https://assets.clarisco.com/assets/case-study/curve.webp" alt="" class="img-fluid">
                                </div>

                                <!-- Objectives -->
                                <div class="col-md-6 pawqeris-objectives-content pawqeris-objectives-left">


                                    <h2 class="case-htags pawqeris-objectives-title mb-2">
                                        Objectives
                                    </h2>

                                    <div class="pawqeris-objectives-line mb-3"></div>

                                    <p class="pawqeris-objectives-intro mb-3 mb-md-4 mb-lg-4">
                                        These objectives put honest effort at the centre, rewarding real activity while
                                        keeping training personal and social. They also make sure coaches and clubs get
                                        tools that save time instead of adding work.
                                    </p>

                                    <ol class="pawqeris-objectives-list list-unstyled mb-0">
                                        <% objectivesData.forEach((objective, index)=> { %>
                                            <li class="d-flex align-items-start mb-2 mb-lg-3 mb-md-3">
                                                <span class="pawqeris-objective-number me-3">
                                                    <%= String(index + 1).padStart(2, '0' ) %>.
                                                </span>

                                                <span class="pawqeris-objective-text">
                                                    <%= objective %>
                                                </span>
                                            </li>
                                            <% }) %>
                                    </ol>

                                </div>


                                <!-- Our Solution -->
                                <div class="col-md-6 pawqeris-objectives-content pawqeris-objectives-right">


                                    <h2 class="case-htags pawqeris-objectives-title mb-2">
                                        <%= solutionData.title %>
                                    </h2>

                                    <div class="pawqeris-objectives-line mb-3"></div>

                                    <p class="pawqeris-solution-description mb-4">
                                        <%= solutionData.description %>
                                    </p>

                                    <div class="pawqeris-solution-highlight text-center">
                                        "Fitness sticks when effort is recognised. Pulsora turns every run, ride and
                                        session into progress people can see, share and be rewarded for."
                                    </div>

                                </div>

                            </div>
                        </div>
                    </section>


                    <% const primaryFeaturesData=[ { title: "Multi-Sport Tracking:" ,
                        description: "Running, cycling, walking, swimming, gym sessions and team sports." }, {
                        title: "Points for Effort:" ,
                        description: "Points reflect real exertion, not just distance, so every fitness level can earn fairly."
                        }, { title: "Personal Score:" ,
                        description: "A daily score that combines physical activity, mental wellbeing, mindful practice, and community participation."
                        }, { title: "Streaks and Milestones:" ,
                        description: "Rewards for steady habits, personal bests, and challenges completed." }, {
                        title: "Reward Wallet:" ,
                        description: "Points can be redeemed for partner offers, discounts, premium features, and event entries."
                        } ]; %>

                        <section class="pawqeris-primary-features  py-5">
                            <div class="container">

                                <div class="text-center mb-4">
                                    <h2 class="case-htags mb-2">
                                        Primary Features
                                    </h2>

                                    <p class="pawqeris-features-description mb-2">
                                        Activity Rewards Engine
                                    </p>

                                    <p class="pawqeris-features-description mb-0">
                                        Workouts are captured through the phone and connected wearables, then converted
                                        into points based on type, duration, intensity, and consistency. Core elements
                                        include:
                                    </p>
