                            description: "A simple routine built around three touchpoints a day, such as a morning check-in, a training session, and an evening reflection."
                            }, { title: "Coach Marketplace" ,
                            description: "Athletes discover, compare, and book verified coaches, with payments handled in-app and the majority of each booking going to the coach."
                            }, { title: "Professional Command Center" ,
                            description: "A web dashboard for coaches, clubs, dietitians and doctors to manage clients, schedules, plans, payments and progress."
                            }, { title: "Wearable Sync" ,
                            description: "Watches and bands feed heart rate, sleep, and activity data into the score and the AI trainer."
                            }, { title: "Clubs and Teams" ,
                            description: "Groups for running clubs, gyms and sports teams, with shared goals, leaderboards and announcements."
                            }, { title: "Challenges and Leaderboards" ,
                            description: "Friendly competitions by distance, effort or consistency, with rewards for winners and participants."
                            }, { title: "Nutrition Support" ,
                            description: "Meal guidance and tracking, with the option to share data with a dietitian."
                            }, { title: "Community Feed" ,
                            description: "A space to share achievements, photos, and encouragement." }, {
                            title: "Events and Partner Offers" ,
                            description: "Access to races, workshops, and brand-sponsored challenges, with offers tied to points."
                            } ]; %>

