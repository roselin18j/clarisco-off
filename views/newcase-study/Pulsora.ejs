                                                                <div class="pawqeris-secondary-label">
                                                                    <h6 class="mb-2">
                                                                        <%= item.title %>
                                                                    </h6>
                                                                </div>
                                                                <div class="pawqeris-secondary-content">
                                                                    <p class="mb-0">
                                                                        <%= item.description %>
                                                                    </p>
                                                                </div>
                                                            </div>
                                                            <% }) %>
                                                    </div>
                                                </div>
                                            </div>
                                </div>
                            </section>

                            <section class="pawqeris-additonal py-5">
                                <div class="container">

                                    <div class="row col-lg-7 mx-auto mb-lg-4 mb-md-3 mb-2">
                                        <div class="col-12 text-center">
                                            <h2 class="case-htags">Additional Features Added by Clarisco</h2>
                                        </div>
                                    </div>

                                    <div class="row g-5 additonal-rows justify-content-center mt-lg-4 mt-md-3 mt-2">

                                        <!-- Left Column -->
                                        <div class="col-lg-6 mt-lg-4 mt-md-3 mt-2">

                                            <div class="mb-3 mb-md-4 mb-lg-5 ">
                                                <h6 class="fw-bold">Anti-Cheat Verification:</h6>
                                                <p class="mb-0">
                                                    Checks for impossible speeds, mock GPS, and duplicate uploads, with
                                                    flagged workouts held for review.
                                                </p>
                                            </div>

                                            <div class="mb-3 mb-md-4 mb-lg-5">
                                                <h6 class="fw-bold">Recovery and Sleep Insights:</h6>
                                                <p class="mb-0">
                                                    Readiness guidance that adapts the plan to rest and strain.
                                                </p>
                                            </div>

                                            <div class="mb-3 mb-md-4 mb-lg-5">
                                                <h6 class="fw-bold">Injury Risk Alerts: </h6>
                                                <p class="mb-0">
                                                    Warnings when training load rises too fast.
                                                </p>
                                            </div>

                                            <div class="mb-3 mb-md-4 mb-lg-5">
                                                <h6 class="fw-bold">Safety Tools: </h6>
                                                <p class="mb-0">
                                                    Live location sharing with a trusted contact during outdoor
                                                    sessions.
                                                </p>
                                            </div>

                                            <div class="mb-3 mb-md-4 mb-lg-5">
                                                <h6 class="fw-bold">Privacy Controls:</h6>
                                                <p class="mb-0">
                                                    Users choose what to share with coaches, clubs, and the community,
                                                    and can withdraw access at any time.
                                                </p>
                                            </div>

                                            <div class="mb-0">
                                                <h6 class="fw-bold">Goal Programs:</h6>
                                                <p class="mb-0">
                                                    Guided plans for first 5K, weight loss, strength, and marathon
                                                    training.
                                                </p>
                                            </div>

                                        </div>

